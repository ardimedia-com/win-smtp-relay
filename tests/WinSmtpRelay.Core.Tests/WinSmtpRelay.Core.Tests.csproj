<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="MSTest" Version="4.2.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <!-- Overrides the vulnerable transitive 2.1.11 (NU1903 / GHSA-2m69-gcr7-jv3q); see WinSmtpRelay.Storage.csproj. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinSmtpRelay.Core\WinSmtpRelay.Core.csproj" />
    <ProjectReference Include="..\..\src\WinSmtpRelay.Storage\WinSmtpRelay.Storage.csproj" />
  </ItemGroup>

  <!-- Installer, data-location and self-update logic (review area E). These classes live in the Windows-only service
       and the net48 custom-action projects, which this test project cannot reference; their pure source files are
       compiled in here. -->
  <ItemGroup>
    <Compile Include="..\..\src\WinSmtpRelay.Service\DataLocation\LegacyDataMigrator.cs" Link="Linked\LegacyDataMigrator.cs" />
    <Compile Include="..\..\src\WinSmtpRelay.Service\Update\UpdatePackageIdentity.cs" Link="Linked\UpdatePackageIdentity.cs" />
    <Compile Include="..\..\setup\WinSmtpRelay.Setup.CustomActions\InstallerInput.cs" Link="Linked\InstallerInput.cs" />
    <Compile Include="..\..\setup\WinSmtpRelay.Setup.CustomActions\UpdateTaskDefinition.cs" Link="Linked\UpdateTaskDefinition.cs" />
  </ItemGroup>

</Project>
