{
	"version": "0.2.0",
	"configurations": [
	
		{
			// F5: build, then run the Windows-service host (Kestrel + Admin UI + SMTP listener) with the
			// debugger attached. The host binds its own Kestrel endpoints from appsettings (Admin UI on
			// https://127.0.0.1:8025), so there is no applicationUrl here — serverReadyAction below detects
			// whatever Kestrel logs. Running the DLL directly bypasses launchSettings.json, so the
			// Development environment is set explicitly via DOTNET_ENVIRONMENT (this is a generic host, not
			// a pure web app, so it reads DOTNET_ENVIRONMENT rather than ASPNETCORE_ENVIRONMENT).
			"name": ".NET Core Launch (web)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/src/WinSmtpRelay.Service/bin/Debug/net10.0-windows/WinSmtpRelay.Service.dll",
			"args": [],
			"cwd": "${workspaceFolder}/src/WinSmtpRelay.Service",
			"stopAtEntry": false,
			"serverReadyAction": {
				// When Kestrel logs its first loopback endpoint ("Now listening on: …"), open a browser
				// there. The pattern matches EITHER scheme, so it fires on whatever the host actually
				// binds: the primary HTTPS Admin UI (https://127.0.0.1:8025) normally, or the
				// Development-only plain-HTTP loopback (http://127.0.0.1:8026) if that is enabled — the
				// port is never hard-coded, it comes from the captured URL. HTTPS triggers the
				// self-signed-certificate warning once per browser (accept it); to avoid that, enable the
				// http loopback (it is logged first and would be opened instead).
				//
				// uriFormat controls the landing page: "%s" is the captured base URL (the app root, which
				// redirects to login/first-run setup). Change it to deep-link a page under test, e.g.
				// "%s/apikeys/new" or "%s/mcp-setup" — the login redirect preserves the target.
				"action": "openExternally",
				"pattern": "\\bNow listening on:\\s+(https?://127\\.0\\.0\\.1:\\S+)",
				"uriFormat": "%s"
			},
			"env": {
				"DOTNET_ENVIRONMENT": "Development"
			}
		}
	]
}
