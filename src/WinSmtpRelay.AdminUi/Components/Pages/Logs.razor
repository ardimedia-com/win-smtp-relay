@page "/logs"
@using System.Diagnostics.Eventing.Reader
@using Microsoft.JSInterop
@attribute [Authorize(Policy = AuthorizationPolicies.HostAdmin)]
@inject IJSRuntime JS
@inject ILogger<Logs> Logger
@implements IDisposable

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem>
            <BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink>
        </BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem>
            <BbBreadcrumbPage>Event Log</BbBreadcrumbPage>
        </BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header page-header-row">
    <div>
        <h1>Event Log</h1>
        <p>
            Windows Event Log entries for WIN-SMTP-RELAY
            @if (handledUntil.HasValue)
            {
                <text> &mdash; @unhandledCount new since last review</text>
            }
        </p>
    </div>
    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => showHelp = true">
        <LucideIcon Name="info" /> About this page
    </BbButton>
</div>

<div class="search-bar">
    <div class="search-input-wrapper">
        <BbInput Placeholder="Search source or message..." Value="@searchText" ValueChanged="OnSearchChanged" aria-label="Search source or message" />
        @if (!string.IsNullOrEmpty(searchText))
        {
            <button type="button" class="search-clear" aria-label="Clear search" @onclick="@(() => OnSearchChanged(""))">
                <LucideIcon Name="x" />
            </button>
        }
    </div>
    <div class="logs-level">
        <label for="log-level" class="sr-only">Level</label>
        <BbNativeSelect Id="log-level" Value="@selectedLevel" ValueChanged="@((string v) => OnLevelChanged(v))">
            <option value="">All Levels</option>
            <option value="Information">Information</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </BbNativeSelect>
    </div>
    <div class="logs-count"><BbInput Type="InputType.Number" Value="@maxEntriesStr" ValueChanged="OnMaxEntriesChanged"
                                     aria-label="Number of entries to load" title="Number of entries to load (1–5000)" /></div>
    <BbButton Variant="ButtonVariant.Secondary" Disabled="@isLoading" @onclick="RefreshLogs">
        <LucideIcon Name="refresh-cw" />
        Refresh
    </BbButton>
    <BbButton Variant="ButtonVariant.Secondary" @onclick="MarkAllHandled" Disabled="@(logEntries.Count == 0 || unhandledCount == 0)">
        <LucideIcon Name="check-check" />
        Mark all as handled
    </BbButton>
    @if (handledUntil.HasValue)
    {
        <BbButton Variant="ButtonVariant.Outline" @onclick="ResetWatermark">
            Reset
        </BbButton>
    }
    <div class="flex items-center gap-1">
        <BbSwitch Checked="showHandled" CheckedChanged="ToggleShowHandled" id="show-handled" />
        <BbLabel For="show-handled">Show handled</BbLabel>
    </div>
</div>

@if (isLoading)
{
    <div class="text-muted row-flex mb-1" role="status">
        <span class="spin row-flex"><LucideIcon Name="loader-circle" Size="16" /></span>
        <span>Reading the Windows Event Log…</span>
    </div>
    <BbSkeleton Class="h-[320px] w-full" />
}
else
{
<BbTable Data="@visibleEntries">
    <BbTableHeader>
        <BbTableRow TData="LogEntry">
            <BbTableHeaderCell TData="LogEntry">Time</BbTableHeaderCell>
            <BbTableHeaderCell TData="LogEntry">Level</BbTableHeaderCell>
            <BbTableHeaderCell TData="LogEntry">Source</BbTableHeaderCell>
            <BbTableHeaderCell TData="LogEntry">Message</BbTableHeaderCell>
        </BbTableRow>
    </BbTableHeader>
    <BbTableBody>
        @if (visibleEntries.Count == 0)
        {
            <BbTableRow TData="LogEntry">
                <BbTableCell colspan="4" style="text-align:center;">
                    @if (logEntries.Count > 0 && !showHandled)
                    {
                        <text>All entries are handled. Toggle &ldquo;Show handled&rdquo; to see them.</text>
                    }
                    else
                    {
                        <text>No log entries found. The Windows Event Log source 'WinSmtpRelay' may not be registered.</text>
                    }
                </BbTableCell>
            </BbTableRow>
        }
        @foreach (var entry in visibleEntries)
        {
            <BbTableRow Item="@entry" class="@($"{GetRowClass(entry)} {(IsHandled(entry) ? "log-handled" : "")} log-row-clickable")"
                        tabindex="0" role="button" aria-label="@($"Show {entry.Level} entry from {entry.Source}")"
                        @onclick="() => selectedEntry = entry" @onkeydown="e => OnRowKey(e, entry)">
                <BbTableCell class="nowrap"><LocalTime Utc="@entry.Time" Format="yyyy-MM-dd HH:mm:ss" /></BbTableCell>
                <BbTableCell><span class="badge-status @GetBadgeCss(entry.Level)">@entry.Level</span></BbTableCell>
                <BbTableCell>@entry.Source</BbTableCell>
                <BbTableCell>
                    @{ var parsed = ParseMessageFields(entry.Message); }
                    <table class="kv-table log-fields">
                        @foreach (var field in parsed)
                        {
                            <tr>
                                <td class="log-field-label">@field.Label:</td>
                                <td class="wrap-anywhere">@field.Value</td>
                            </tr>
                        }
                    </table>
                </BbTableCell>
            </BbTableRow>
        }
    </BbTableBody>
</BbTable>
}

<BbDialog Open="@(selectedEntry is not null)" OpenChanged="@(open => { if (!open) selectedEntry = null; })">
    <BbDialogContent>
        @if (selectedEntry is not null)
        {
            <BbDialogHeader>
                <BbDialogTitle>
                    <span class="badge-status @GetBadgeCss(selectedEntry.Level)">@selectedEntry.Level</span>
                </BbDialogTitle>
                <BbDialogDescription><LocalTime Utc="@selectedEntry.Time" Format="yyyy-MM-dd HH:mm:ss" /> &mdash; @selectedEntry.Source</BbDialogDescription>
            </BbDialogHeader>
            <div class="dialog-body log-entry-body">
                @foreach (var field in ParseMessageFields(selectedEntry.Message))
                {
                    <div class="mb-half">
                        <strong class="text-muted">@field.Label</strong><br />
                        <span class="wrap-anywhere">@field.Value</span>
                    </div>
                }
            </div>
            <BbDialogFooter>
                <BbDialogClose>
                    <BbButton Variant="ButtonVariant.Outline">Close</BbButton>
                </BbDialogClose>
            </BbDialogFooter>
        }
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showHelp">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>About the Event Log</BbDialogTitle>
            <BbDialogDescription>Windows Event Log viewer for WIN-SMTP-RELAY</BbDialogDescription>
        </BbDialogHeader>
        <div class="dialog-body">
            <p>
                This page reads entries from the <strong>Windows Event Log</strong> (Application log) written by
                the WIN-SMTP-RELAY service. It provides a convenient way to inspect service-level events without
                opening the Windows Event Viewer.
            </p>
            <h3>Event levels</h3>
            <ul>
                <li><strong>Information</strong> &mdash; normal operations: service start/stop, configuration loaded, delivery summaries.</li>
                <li><strong>Warning</strong> &mdash; non-critical issues: temporary delivery failures, rate-limit hits, certificate expiry warnings.</li>
                <li><strong>Error</strong> &mdash; critical failures: unhandled exceptions, database errors, TLS handshake failures.</li>
            </ul>
            <h3>Search &amp; filtering</h3>
            <p>
                Use the <strong>search box</strong> to filter entries by source or message text. The
                <strong>level dropdown</strong> filters by severity. The <strong>entry count</strong> field
                limits how many entries are loaded (default 100). Changes apply immediately. Click
                <strong>Refresh</strong> to reload entries from the Windows Event Log.
            </p>
            <h3>Marking entries as handled</h3>
            <p>
                Click <strong>Mark all as handled</strong> to acknowledge all current entries. Handled entries
                are dimmed and can be hidden with the <strong>Show handled</strong> toggle. The handled state
                is stored in your browser &mdash; each admin has their own independent view. Use
                <strong>Reset</strong> to clear the watermark and show all entries as unhandled again.
            </p>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Close</BbButton>
            </BbDialogClose>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private const string StorageKey = "winsmtprelay-log-handled-until";
    private const string ShowHandledKey = "winsmtprelay-log-show-handled";
    private const int MaxEntriesLimit = 5000;

    private bool showHelp;
    private bool isLoading = true;
    private List<LogEntry> logEntries = [];
    private string selectedLevel = "";
    private string searchText = "WinSmtpRelay";
    private string maxEntriesStr = "100";

    private DateTimeOffset? handledUntil;
    private bool showHandled;
    private int unhandledCount;
    private List<LogEntry> visibleEntries = [];
    private LogEntry? selectedEntry;

    // Loads are serialized (one Event Log read at a time) and results are applied on the circuit thread only,
    // so the list the renderer enumerates is never mutated from a thread-pool thread.
    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private CancellationTokenSource? _debounce;
    private bool _disposed;

    private int MaxEntries =>
        int.TryParse(maxEntriesStr, out var v) ? Math.Clamp(v, 1, MaxEntriesLimit) : 100;

    // The Windows Event Log read is synchronous and can take several seconds. Defer it until after the
    // first paint (and run it off the circuit thread) so the page shows immediately with a loading
    // indicator instead of blocking the initial render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await ReadWatermark();
            var showHandledStr = await JS.InvokeAsync<string?>("localStorage.getItem", ShowHandledKey);
            showHandled = showHandledStr == "true";
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Browser storage unavailable: start with nothing marked as handled.
        }
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        if (_disposed) return;
        await _loadLock.WaitAsync();
        try
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);

            // Offload the blocking EventLogReader scan to a thread-pool thread so the circuit stays responsive;
            // the reader returns a NEW list that is assigned here, on the circuit thread.
            var level = selectedLevel;
            var max = MaxEntries;
            var (entries, error) = await Task.Run(() => ReadEntries(level, max));
            if (error is not null)
                Logger.LogWarning(error, "Reading the Windows Event Log for the Event Log page failed");

            logEntries = entries;
            UpdateUnhandledCount();
            UpdateVisibleEntries();
        }
        finally
        {
            isLoading = false;
            _loadLock.Release();
        }

        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { /* circuit gone while the log read was in flight */ }
        catch (OperationCanceledException) { /* circuit gone while the log read was in flight */ }
    }

    private async Task ReadWatermark()
    {
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (stored is not null && DateTimeOffset.TryParse(stored, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt))
            handledUntil = dt;
    }

    private async Task MarkAllHandled()
    {
        var latest = logEntries.Count > 0 ? logEntries[0].Time : DateTimeOffset.UtcNow;
        handledUntil = latest;
        UpdateUnhandledCount();
        UpdateVisibleEntries();
        try { await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, latest.ToString("O")); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { /* not persisted */ }
    }

    private async Task ResetWatermark()
    {
        handledUntil = null;
        UpdateUnhandledCount();
        UpdateVisibleEntries();
        try { await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { /* not persisted */ }
    }

    private async Task ToggleShowHandled(bool value)
    {
        showHandled = value;
        UpdateVisibleEntries();
        try { await JS.InvokeVoidAsync("localStorage.setItem", ShowHandledKey, value ? "true" : "false"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { /* not persisted */ }
    }

    // Search filters the loaded entries in memory; it is debounced so typing does not re-filter (and re-render
    // the whole table) on every keystroke.
    private async Task OnSearchChanged(string value)
    {
        searchText = value;
        if (string.IsNullOrEmpty(value))
        {
            UpdateVisibleEntries();
            return;
        }
        if (await DebounceAsync())
            UpdateVisibleEntries();
    }

    private async Task OnLevelChanged(string value)
    {
        selectedLevel = value;
        await LoadLogsAsync();
    }

    // The entry count re-reads the Event Log, so wait until the operator stops typing.
    private async Task OnMaxEntriesChanged(string value)
    {
        maxEntriesStr = value;
        if (await DebounceAsync())
            await LoadLogsAsync();
    }

    /// <summary>Waits 400 ms; false when a newer keystroke superseded this one (or the page closed).</summary>
    private async Task<bool> DebounceAsync()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
            return !_disposed;
        }
        catch (TaskCanceledException)
        {
            return false;
        }
    }

    private async Task RefreshLogs()
    {
        try { await ReadWatermark(); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { /* keep the current watermark */ }
        await LoadLogsAsync();
    }

    private void OnRowKey(KeyboardEventArgs e, LogEntry entry)
    {
        if (e.Key is "Enter" or " ")
            selectedEntry = entry;
    }

    /// <summary>
    /// Reads the newest <paramref name="max"/> matching entries. The query runs newest-first and stops as soon
    /// as enough entries are collected, instead of scanning the whole Application log.
    /// </summary>
    private static (List<LogEntry> Entries, Exception? Error) ReadEntries(string level, int max)
    {
        var entries = new List<LogEntry>();
        try
        {
            if (!OperatingSystem.IsWindows()) return (entries, null);

            var query = "*[System[Provider[@Name='WinSmtpRelay'] or Provider[@Name='.NET Runtime']]]";
            using var logReader = new EventLogReader(new EventLogQuery("Application", PathType.LogName, query)
            {
                ReverseDirection = true
            });

            EventRecord? record;
            while (entries.Count < max && (record = logReader.ReadEvent()) is not null)
            {
                using (record)
                {
                    var recordLevel = record.Level switch
                    {
                        (byte)StandardEventLevel.Error or (byte)StandardEventLevel.Critical => "Error",
                        (byte)StandardEventLevel.Warning => "Warning",
                        _ => "Information"
                    };

                    if (!string.IsNullOrEmpty(level) && recordLevel != level)
                        continue;

                    var message = record.FormatDescription() ?? "(no message)";
                    if (IsNoiseMessage(message))
                        continue;

                    // TimeCreated is the server's local time; keep the instant as a DateTimeOffset so the page can
                    // show it in the viewer's time zone.
                    var created = record.TimeCreated is { } t ? new DateTimeOffset(t.ToUniversalTime(), TimeSpan.Zero) : DateTimeOffset.MinValue;
                    entries.Add(new LogEntry(created, recordLevel, record.ProviderName ?? "Unknown", message));
                }
            }

            return ([.. entries.OrderByDescending(e => e.Time)], null);
        }
        catch (Exception ex)
        {
            entries.Add(new LogEntry(DateTimeOffset.UtcNow, "Error", "LogViewer",
                "The Windows Event Log could not be read. The details were written to the server log."));
            return (entries, ex);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _debounce?.Cancel();
        _debounce?.Dispose();
    }

    private static bool IsNoiseMessage(string message) =>
        message.Contains("failure initializing profiling API", StringComparison.OrdinalIgnoreCase);

    private bool IsHandled(LogEntry entry) =>
        handledUntil.HasValue && entry.Time <= handledUntil.Value;

    private void UpdateUnhandledCount() =>
        unhandledCount = logEntries.Count(e => !IsHandled(e));

    private void UpdateVisibleEntries()
    {
        var entries = showHandled ? logEntries : logEntries.Where(e => !IsHandled(e));
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            entries = entries.Where(e =>
                e.Source.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                e.Message.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }
        visibleEntries = entries.ToList();
    }

    private string GetRowClass(LogEntry entry) => entry.Level switch
    {
        "Error" => "row-error",
        "Warning" => "row-warning",
        _ => ""
    };

    private static string GetBadgeCss(string level) => level switch
    {
        "Error" => "badge-error",
        "Warning" => "badge-warning",
        _ => "badge-muted"
    };

    private static string Truncate(string text, int maxLen) =>
        text.Length > maxLen ? text[..maxLen] + "..." : text;

    /// <summary>
    /// Extracts the core message from .NET Runtime formatted event log entries.
    /// Input:  "Category: Some.Namespace.Class EventId: 0 Sender foo@bar.com rejected: domain bar.com not in accepted sender domains"
    /// Output: "Sender foo@bar.com rejected: domain bar.com not in accepted sender domains"
    /// </summary>
    private static string ExtractCoreMessage(string message)
    {
        // .NET Runtime format: "Category: ... EventId: N actual message"
        var eventIdMarker = "EventId: ";
        var idx = message.IndexOf(eventIdMarker, StringComparison.Ordinal);
        if (idx < 0)
            return message;

        // Skip past digits and whitespace after "EventId: "
        var pos = idx + eventIdMarker.Length;
        while (pos < message.Length && char.IsDigit(message[pos]))
            pos++;
        while (pos < message.Length && char.IsWhiteSpace(message[pos]))
            pos++;

        return pos < message.Length ? message[pos..] : message;
    }

    /// <summary>
    /// Parses a .NET Runtime event log message into structured label/value fields.
    /// </summary>
    private static List<(string Label, string Value)> ParseMessageFields(string message)
    {
        var fields = new List<(string Label, string Value)>();

        // Try to parse .NET Runtime format: "Category: X EventId: N message"
        var eventIdMarker = "EventId: ";
        var eventIdIdx = message.IndexOf(eventIdMarker, StringComparison.Ordinal);

        if (eventIdIdx >= 0)
        {
            // Extract Category
            var categoryPrefix = "Category: ";
            var catIdx = message.IndexOf(categoryPrefix, StringComparison.Ordinal);
            if (catIdx >= 0)
            {
                var catValue = message[(catIdx + categoryPrefix.Length)..eventIdIdx].Trim();
                fields.Add(("Category", catValue));
            }

            // Extract EventId (digits only) and message (everything after)
            var afterEventId = eventIdIdx + eventIdMarker.Length;
            var numberEnd = afterEventId;
            while (numberEnd < message.Length && char.IsDigit(message[numberEnd]))
                numberEnd++;

            var eventId = message[afterEventId..numberEnd];
            fields.Add(("Event ID", eventId));

            // Skip any whitespace between the number and the message text
            var msgStart = numberEnd;
            while (msgStart < message.Length && char.IsWhiteSpace(message[msgStart]))
                msgStart++;

            if (msgStart < message.Length)
                fields.Add(("Message", message[msgStart..]));
        }
        else
        {
            // Not a .NET Runtime format — show as-is
            fields.Add(("Message", message));
        }

        return fields;
    }

    private record LogEntry(DateTimeOffset Time, string Level, string Source, string Message);
}
