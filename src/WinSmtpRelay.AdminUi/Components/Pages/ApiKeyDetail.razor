@page "/apikeys/new"
@page "/apikeys/{Id:int}"
@using WinSmtpRelay.Core.Authorization
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.AdminFull)]
@inject ITenantScopeFactory ScopeFactory
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Nav

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/apikeys">API Keys</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(IsNew ? "New" : key?.Name)</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>@(IsNew ? "New API key" : $"API key: {key?.Name}")</h1>
    <p>Keys for programmatic access to the admin API. The secret is shown only once at creation.</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else if (notFound)
{
    <p class="text-danger">API key not found.</p>
    <BbButton Variant="ButtonVariant.Outline" @onclick="GoBack"><LucideIcon Name="arrow-left" /> Back</BbButton>
}
else if (createdSecret is not null)
{
    @* One-time secret display after creation. The plaintext is never persisted and cannot be recovered. *@
    <div>
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>API key created</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <div class="badge-status badge-warning" style="display:block;padding:0.75rem;line-height:1.5;margin-bottom:1rem;">
                    <strong>Copy this secret now &mdash; it will not be shown again.</strong>
                    The plaintext key is not stored; only a hash is kept. If you lose it you must create a new key.
                </div>
                <div class="form-group">
                    <BbLabel For="secret">Secret</BbLabel>
                    <div style="display:flex;gap:0.5rem;align-items:center;">
                        <BbInput Id="secret" Value="@createdSecret" ReadOnly="true" Class="mono" />
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" title="Copy" @onclick="CopySecretAsync">
                            <LucideIcon Name="copy" /> Copy
                        </BbButton>
                    </div>
                    @if (copied)
                    {
                        <span class="text-muted" style="font-size:0.8125rem;">Copied to clipboard</span>
                    }
                </div>
            </BbCardContent>
            <BbCardFooter>
                <BbButton Variant="ButtonVariant.Default" @onclick="GoBack">Done</BbButton>
            </BbCardFooter>
        </BbCard>
    </div>
}
else if (IsNew)
{
    <div>
        <BbCard>
            <BbCardContent>
                <div class="form-group">
                    <BbLabel For="name">Name</BbLabel>
                    <BbInput Id="name" @bind-Value="newName" Placeholder="ci-pipeline" />
                </div>
                <div class="form-group">
                    <BbLabel For="role">Role</BbLabel>
                    <BbNativeSelect TValue="string" Id="role" @bind-Value="newRole">
                        @if (ScopeTenantId is null)
                        {
                            @* Host scope: a tenant-role key without a tenant would carry no memberships
                               and could access nothing — host-level keys are HostAdmin, limited by scopes. *@
                            <option value="@RelayRoles.HostAdmin">Host admin (host-level key)</option>
                        }
                        else
                        {
                            <option value="@RelayRoles.TenantViewer">Viewer (read-only)</option>
                            <option value="@RelayRoles.TenantAdmin">Admin (read/write)</option>
                        }
                    </BbNativeSelect>
                </div>
                @RenderScopeEditor()
            </BbCardContent>
            <BbCardFooter>
                <div class="flex gap-1 items-center">
                    <BbButton Variant="ButtonVariant.Default" @onclick="CreateAsync" Disabled="@(creating || string.IsNullOrWhiteSpace(newName))">
                        <LucideIcon Name="plus" /> Create
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" @onclick="GoBack">Cancel</BbButton>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <span class="text-muted" style="margin-left:0.5rem">@statusMessage</span>
                    }
                </div>
            </BbCardFooter>
        </BbCard>
    </div>
}
else if (key is not null)
{
    <div>
        <BbCard>
            <BbCardContent>
                <div class="form-group">
                    <BbLabel>Name</BbLabel>
                    <div>@key.Name</div>
                </div>
                <div class="form-group">
                    <BbLabel>Prefix</BbLabel>
                    <div><span class="mono">@(key.KeyPrefix)…</span></div>
                </div>
                <div class="form-group">
                    <BbLabel>Role</BbLabel>
                    <div>@key.Role</div>
                </div>
                <div class="form-group">
                    <BbLabel>Created</BbLabel>
                    <div><LocalTime Utc="@key.CreatedUtc" Format="yyyy-MM-dd HH:mm" /></div>
                </div>
                <div class="form-group">
                    <BbLabel>Last used</BbLabel>
                    <div><LocalTime Utc="@key.LastUsedUtc" /></div>
                </div>
                <div class="form-group">
                    <BbLabel>Status</BbLabel>
                    <div><span class="badge-status @(key.IsEnabled ? "badge-success" : "badge-muted")">@(key.IsEnabled ? "Enabled" : "Disabled")</span></div>
                </div>
                @RenderScopeEditor()
                <p class="text-muted" style="font-size:0.8125rem;">The secret is not stored in plaintext and cannot be re-displayed.</p>
            </BbCardContent>
            <BbCardFooter>
                <div class="flex gap-1 items-center">
                    <BbButton Variant="ButtonVariant.Default" @onclick="SaveScopesAsync" Disabled="@savingScopes">
                        <LucideIcon Name="save" /> Save scopes
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Destructive" @onclick="() => showRevoke = true">
                        <LucideIcon Name="trash-2" /> Revoke
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" @onclick="GoBack">Back</BbButton>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <span class="text-muted" style="margin-left:0.5rem">@statusMessage</span>
                    }
                </div>
            </BbCardFooter>
        </BbCard>
    </div>
}

<BbAlertDialog @bind-Open="showRevoke">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Revoke API key</BbAlertDialogTitle>
            <BbAlertDialogDescription>Clients using this key will immediately lose access.</BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" @onclick="ConfirmRevokeAsync">Revoke</BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsNew => Id is null;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool isLoading = true;
    private bool notFound;
    private string? statusMessage;

    // Create form state.
    private string newName = "";
    private string newRole = RelayRoles.TenantViewer;
    private bool creating;

    // Scope editor state ("none" | "read" | "write" per area, plus the body switch). Shared between
    // the create form and the edit view — scopes are the only mutable part of an existing key.
    private readonly Dictionary<string, string> areaAccess = ApiKeyScopes.Areas.ToDictionary(a => a, _ => "none");
    private bool bodyScope;
    private bool savingScopes;

    private static readonly (string Area, string Label, string Hint)[] AreaRows =
    [
        (ApiKeyScopes.Diag, "Diagnostics", "Metrics, statistics, delivery logs, queue status, server info"),
        (ApiKeyScopes.Messages, "Messages", "Queued-message metadata (bodies need the switch below)"),
        (ApiKeyScopes.Queue, "Queue operations", "Retry and delete queued messages"),
        (ApiKeyScopes.Config, "Configuration", "Connectors, domains, IP rules, routes, DKIM, rate limits, filters"),
        (ApiKeyScopes.Admin, "Administration", "Tenants, relay users, API keys"),
    ];

    private RenderFragment RenderScopeEditor() => __builder =>
    {
        <div class="form-group">
            <BbLabel>Scopes</BbLabel>
            <p class="text-muted" style="font-size:0.8125rem;margin:0 0 0.5rem;">
                Scopes restrict what this key may do within its role. A key without any scope is
                <strong>read-only</strong>; write access must be granted per area.
            </p>
            @foreach (var row in AreaRows)
            {
                var area = row.Area;
                <div style="display:flex;gap:0.75rem;align-items:center;margin-bottom:0.35rem;">
                    <BbNativeSelect TValue="string" Value="@areaAccess[area]" ValueChanged="@((string v) => areaAccess[area] = v)" style="width:11rem;">
                        <option value="none">No access</option>
                        <option value="read">Read</option>
                        <option value="write">Read + write</option>
                    </BbNativeSelect>
                    <div>
                        <div>@row.Label</div>
                        <div class="text-muted" style="font-size:0.78rem;">@row.Hint</div>
                    </div>
                </div>
            }
            <div style="display:flex;gap:0.75rem;align-items:center;margin-top:0.5rem;">
                <BbSwitch Checked="bodyScope" CheckedChanged="@((bool v) => bodyScope = v)" id="scope-body" />
                <div>
                    <div>Raw message bodies (<code>messages:body</code>)</div>
                    <div class="text-muted" style="font-size:0.78rem;">Customer mail content — never implied by other scopes. Also requires an Admin/Host role.</div>
                </div>
            </div>
            @if (ScopesAreEmpty)
            {
                <p class="text-muted" style="font-size:0.8125rem;margin-top:0.5rem;">
                    No scopes selected — this key will be <strong>read-only</strong> across all areas.
                </p>
            }
        </div>
    };

    private bool ScopesAreEmpty => !bodyScope && areaAccess.Values.All(v => v == "none");

    private string? BuildScopes()
    {
        var list = new List<string>();
        foreach (var (area, access) in areaAccess)
        {
            if (access == "read") list.Add(ApiKeyScopes.Read(area));
            else if (access == "write") list.Add(ApiKeyScopes.Write(area));
        }
        if (bodyScope) list.Add(ApiKeyScopes.MessagesBody);
        return ApiKeyScopes.Normalize(list);
    }

    private void LoadScopeEditor(string? scopes)
    {
        var set = ApiKeyScopes.Parse(scopes);
        foreach (var area in ApiKeyScopes.Areas)
        {
            areaAccess[area] = set.Contains(ApiKeyScopes.Write(area)) ? "write"
                : set.Contains(ApiKeyScopes.Read(area)) ? "read"
                : "none";
        }
        bodyScope = ApiKeyScopes.AllowsBody(set);
    }

    // One-time secret shown after creation; null until a key is created.
    private string? createdSecret;
    private bool copied;

    // Edit/view state.
    private ApiKey? key;
    private bool showRevoke;

    private int? ScopeTenantId => CurrentTenant.FilterEnabled ? CurrentTenant.FilterTenantId : null;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            // Host scope mints host-level keys; tenant scope mints tenant keys (see the role select).
            newRole = ScopeTenantId is null ? RelayRoles.HostAdmin : RelayRoles.TenantViewer;
            isLoading = false;
            return;
        }

        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
        // GetAllAsync is already scoped to the current tenant, so this also enforces authorization.
        var all = await svc.GetAllAsync(ScopeTenantId);
        key = all.FirstOrDefault(k => k.Id == Id!.Value);
        if (key is null)
            notFound = true;
        else
            LoadScopeEditor(key.Scopes);
        isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (creating) return;   // double-submit guard (before the first await)

        // A tenant-scoped admin may only mint tenant-role keys (newRole is client-supplied).
        if (ScopeTenantId is not null && newRole is not (RelayRoles.TenantAdmin or RelayRoles.TenantViewer))
        {
            statusMessage = "Invalid role for a tenant API key.";
            return;
        }

        creating = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
            var (_, plaintext) = await svc.CreateAsync(ScopeTenantId, newName.Trim(), newRole, BuildScopes(), null);
            // Show the secret on this page; do NOT navigate away before the user can copy it.
            createdSecret = plaintext;
        }
        finally
        {
            creating = false;
        }
    }

    private async Task SaveScopesAsync()
    {
        if (savingScopes || key is null) return;   // double-submit guard (before the first await)
        savingScopes = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
            await svc.UpdateScopesAsync(key.Id, BuildScopes());
            statusMessage = "Scopes saved. Active immediately for new requests.";
        }
        finally
        {
            savingScopes = false;
        }
    }

    private async Task CopySecretAsync()
    {
        if (createdSecret is null)
            return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", createdSecret);
        copied = true;
    }

    private async Task ConfirmRevokeAsync()
    {
        showRevoke = false;
        if (key is null)
            return;
        // Only revoke keys in the current tenant scope (key was loaded scoped to ScopeTenantId).
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
        await svc.DeleteAsync(key.Id);
        GoBack();
    }

    private void GoBack() => Nav.NavigateTo("/apikeys");
}
