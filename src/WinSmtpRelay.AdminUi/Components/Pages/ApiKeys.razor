@page "/apikeys"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.AdminFull)]
@inject ITenantScopeFactory ScopeFactory
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Nav
@inject ILogger<ApiKeys> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem>
            <BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink>
        </BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem>
            <BbBreadcrumbPage>API Keys</BbBreadcrumbPage>
        </BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header page-header-row">
    <div>
        <h1>API Keys</h1>
        <p>Keys for programmatic access to the admin API. Send as <code>X-Api-Key</code> or <code>Authorization: Bearer</code>. The secret is shown only once.</p>
    </div>
    <div class="flex gap-1 items-center">
        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" @onclick="@(() => Nav.NavigateTo("/apikeys/new"))">
            <LucideIcon Name="plus" /> New API key
        </BbButton>
    </div>
</div>

@if (!string.IsNullOrEmpty(actionError))
{
    <p class="form-error mb-1" role="alert">@actionError</p>
}

@if (isLoading)
{
    <BbSkeleton Class="h-[200px] w-full" />
}
else
{
    <BbTable Data="@keys">
        <BbTableHeader>
            <BbTableRow TData="ApiKey">
                <BbTableHeaderCell TData="ApiKey">Name</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Prefix</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Role</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Scopes</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Created</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Last used</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey">Expires</BbTableHeaderCell>
                <BbTableHeaderCell TData="ApiKey"></BbTableHeaderCell>
            </BbTableRow>
        </BbTableHeader>
        <BbTableBody>
            @if (keys.Count == 0)
            {
                <BbTableRow TData="ApiKey">
                    <BbTableCell colspan="8" style="text-align:center;">No API keys</BbTableCell>
                </BbTableRow>
            }
            @foreach (var k in keys)
            {
                <BbTableRow Item="@k" class="list-row-clickable" tabindex="0" role="link" @onclick="() => View(k.Id)" @onkeydown="args => OnRowKey(args, () => View(k.Id))">
                    <BbTableCell>@k.Name</BbTableCell>
                    <BbTableCell><span class="mono">@(k.KeyPrefix)…</span></BbTableCell>
                    <BbTableCell>@k.Role</BbTableCell>
                    <BbTableCell>
                        @if (string.IsNullOrEmpty(k.Scopes))
                        {
                            <span class="badge-status badge-muted">read-only</span>
                        }
                        else
                        {
                            <span class="mono" style="font-size:0.78rem;">@k.Scopes</span>
                        }
                    </BbTableCell>
                    <BbTableCell><LocalTime Utc="@k.CreatedUtc" Format="yyyy-MM-dd" /></BbTableCell>
                    <BbTableCell><LocalTime Utc="@k.LastUsedUtc" /></BbTableCell>
                    <BbTableCell>@if (k.ExpiresUtc is null) { <span class="text-muted">never</span> } else { <LocalTime Utc="@k.ExpiresUtc" Format="yyyy-MM-dd" /> }</BbTableCell>
                    <BbTableCell>
                        <div class="list-row-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Revoke" aria-label="Revoke"
                                    @onclick="() => { revokeTargetId = k.Id; showRevoke = true; }">
                                <LucideIcon Name="trash-2" />
                            </BbButton>
                        </div>
                    </BbTableCell>
                </BbTableRow>
            }
        </BbTableBody>
    </BbTable>
}

<BbAlertDialog @bind-Open="showRevoke">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Revoke API key</BbAlertDialogTitle>
            <BbAlertDialogDescription>Clients using this key will immediately lose access.</BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" @onclick="ConfirmRevokeAsync" Disabled="@busy">Revoke</BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

@code {
    private bool busy;
    private string? actionError;

    // Opens the row's detail with the keyboard (rows are focusable: tabindex="0").
    private static void OnRowKey(KeyboardEventArgs e, Action open)
    {
        if (e.Key is "Enter" or " ")
            open();
    }

    private IReadOnlyList<ApiKey> keys = [];
    private bool isLoading = true;
    private bool showRevoke;
    private int revokeTargetId;

    private int? ScopeTenantId => CurrentTenant.FilterEnabled ? CurrentTenant.FilterTenantId : null;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        isLoading = true;
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
        keys = await svc.GetAllAsync(ScopeTenantId);
        isLoading = false;
    }

    private void View(int id) => Nav.NavigateTo($"/apikeys/{id}");

    private async Task ConfirmRevokeAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        busy = true;
        actionError = null;
        try
        {
            showRevoke = false;
            // Only revoke keys in the current tenant scope (keys was loaded scoped to ScopeTenantId).
            if (!keys.Any(k => k.Id == revokeTargetId))
                return;
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IApiKeyService>();
            await svc.DeleteAsync(revokeTargetId);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Action} on the {Page} page failed", "ConfirmRevokeAsync", "ApiKeys");
            actionError = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }
}
