@page "/filters/headers/new"
@page "/filters/headers/{Id:int}"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.AdminFull)]
@inject ITenantScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject ILogger<HeaderRuleDetail> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/filters?tab=headers">Message Filters</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(IsNew ? "New header rule" : headerName)</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>@(IsNew ? "New header rule" : $"Edit header rule")</h1>
    <p>Rewrite, add, or remove a header on outgoing messages</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else if (notFound)
{
    <p class="text-danger">Header rule not found.</p>
    <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel"><LucideIcon Name="arrow-left" /> Back</BbButton>
}
else
{
    <BbCard>
        <BbCardContent>
            <div class="form-grid">
                <div class="form-group col-span-full">
                    <BbLabel For="header-name">Header Name</BbLabel>
                    <BbInput Id="header-name" @bind-Value="headerName" Placeholder="X-Custom-Header" />
                </div>
                <div class="form-group">
                    <BbLabel For="action">Action</BbLabel>
                    <BbNativeSelect Id="action" @bind-Value="action">
                        <option value="Set">Set</option>
                        <option value="Remove">Remove</option>
                        <option value="Append">Append</option>
                    </BbNativeSelect>
                </div>
                <div class="form-group">
                    <BbLabel For="match-value">Match Value (optional, exact match)</BbLabel>
                    <BbInput Id="match-value" @bind-Value="matchValue" Placeholder="exact current header value" />
                </div>
                <div class="form-group">
                    <BbLabel For="new-value">New Value</BbLabel>
                    <BbInput Id="new-value" @bind-Value="newValue" Placeholder="new value" />
                </div>
                <div class="form-group">
                    <BbLabel For="sort-order">Sort Order</BbLabel>
                    <BbInput Id="sort-order" Type="InputType.Number" @bind-Value="sortOrder" />
                </div>
                <div class="form-group">
                    <BbLabel For="enabled">Enabled</BbLabel>
                    <BbNativeSelect Id="enabled" @bind-Value="enabled">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </BbNativeSelect>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }
        </BbCardContent>
        <BbCardFooter>
            <div class="flex gap-1 items-center">
                <BbButton Variant="ButtonVariant.Default" @onclick="SaveAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(headerName))">
                    <LucideIcon Name="save" /> Save
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel">Cancel</BbButton>
            </div>
        </BbCardFooter>
    </BbCard>
}

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsNew => Id is null;

    private bool isLoading = true;
    private bool notFound;
    private bool busy;
    private string? errorMessage;

    private string headerName = "";
    private string action = "Set";
    private string matchValue = "";
    private string newValue = "";
    private string sortOrder = "0";
    private string enabled = "true";

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IMessageFilterService>();
        var rules = await svc.GetHeaderRulesAsync();

        if (IsNew)
        {
            sortOrder = (rules.Count > 0 ? rules.Max(r => r.SortOrder) + 1 : 1).ToString();
            isLoading = false;
            return;
        }

        var r = rules.FirstOrDefault(x => x.Id == Id!.Value);
        if (r is null) { notFound = true; isLoading = false; return; }

        headerName = r.HeaderName;
        action = r.Action;
        matchValue = r.MatchValue ?? "";
        newValue = r.NewValue ?? "";
        sortOrder = r.SortOrder.ToString();
        enabled = r.IsEnabled.ToString().ToLowerInvariant();
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        errorMessage = null;

        // RFC 5322 field name: printable ASCII except the colon, no spaces.
        var name = headerName.Trim();
        if (name.Length == 0 || name.Any(ch => ch < 33 || ch > 126 || ch == ':'))
        {
            errorMessage = "Header name: use letters, digits and dashes only (no spaces or colon), e.g. X-Custom-Header.";
            return;
        }
        if (!InputValidation.TryParseInt(sortOrder, "Sort order", 0, int.MaxValue, out var order, out var orderError))
        {
            errorMessage = orderError;
            return;
        }

        busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IMessageFilterService>();

            var entry = new HeaderRewriteEntry
            {
                Id = Id ?? 0,
                HeaderName = name,
                Action = action,
                MatchValue = string.IsNullOrWhiteSpace(matchValue) ? null : matchValue.Trim(),
                NewValue = string.IsNullOrWhiteSpace(newValue) ? null : newValue.Trim(),
                SortOrder = order,
                IsEnabled = enabled == "true"
            };

            if (IsNew) await svc.CreateHeaderRuleAsync(entry);
            else await svc.UpdateHeaderRuleAsync(entry);
            Nav.NavigateTo("/filters?tab=headers");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving header rule {HeaderName} failed", name);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/filters?tab=headers");
}
