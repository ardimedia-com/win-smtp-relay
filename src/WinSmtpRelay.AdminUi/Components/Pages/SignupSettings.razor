@page "/host/signup"
@using Microsoft.Extensions.Options
@using WinSmtpRelay.Core.Configuration
@using WinSmtpRelay.Core.Interfaces
@attribute [Authorize(Policy = AuthorizationPolicies.HostAdmin)]
@inject IServiceScopeFactory ScopeFactory
@inject IOptions<AdminUiOptions> UiOptions
@inject ILogger<SignupSettings> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem>
            <BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink>
        </BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem>
            <BbBreadcrumbPage>Signup</BbBreadcrumbPage>
        </BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>Self-service signup</h1>
    <p>Host-level setting — whether anonymous visitors may create their own tenant. Applied immediately — no restart required.</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[160px] w-full" />
}
else
{
    <BbCard>
        <BbCardContent>
            <div class="settings-group">
                <div class="settings-group-title">Self-service signup</div>
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <BbSwitch Checked="signupEnabled" CheckedChanged="OnToggleAsync" id="signup-toggle" Disabled="@busy" />
                    <label for="signup-toggle" style="cursor:pointer;">Allow anonymous visitors to sign up at <span class="mono">/signup</span></label>
                </div>
                <p class="text-muted" style="font-size:0.8rem;margin-top:0.75rem;margin-bottom:0;">
                    When enabled, a "Create an organization" link appears on the sign-in page. A new signup creates a
                    <strong>disabled</strong> tenant that must be confirmed by email verification or host approval before it can sign in.
                </p>
            </div>

            <div class="settings-group">
                <div class="settings-group-title">System emails</div>
                @if (!fromAddressConfigured)
                {
                    <div class="badge-status badge-warning" style="display:block;padding:0.6rem 0.75rem;line-height:1.5;margin-bottom:0.85rem;">
                        <strong>No from-address is set.</strong> Password-reset, sign-in-link, and signup-verification
                        emails will <strong>not be sent</strong> until you set one below.
                    </div>
                }
                <div class="form-group" style="margin-bottom:0;">
                    <BbLabel For="from-address">From-address</BbLabel>
                    <div class="row-flex">
                        <BbInput Id="from-address" @bind-Value="signupFromAddress" Placeholder="noreply@yourdomain.tld" />
                        <BbButton Variant="ButtonVariant.Default" @onclick="SaveFromAddressAsync" Disabled="@busy">
                            <LucideIcon Name="save" /> Save
                        </BbButton>
                    </div>
                    <p class="text-muted" style="font-size:0.8rem;margin-top:0.5rem;margin-bottom:0;">
                        From-address for the emails this relay sends itself — signup verification, password reset, and
                        sign-in links — through its own delivery pipeline. Leave blank to use the
                        <span class="mono">appsettings</span> value. The domain should be one this relay is configured to
                        send for (accepted sender domain, ideally with DKIM).
                    </p>
                </div>
            </div>

            <div class="settings-group">
                <div class="settings-group-title">Account recovery</div>
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <BbSwitch Checked="emailRecoveryEnabled" CheckedChanged="OnEmailRecoveryToggleAsync" id="recovery-toggle" Disabled="@busy" />
                    <label for="recovery-toggle" style="cursor:pointer;">Allow the email sign-in link and password reset</label>
                </div>
                <p class="text-muted" style="font-size:0.8rem;margin-top:0.75rem;margin-bottom:0;">
                    When off, the "Email me a sign-in link" button and "Forgot your password?" reset are hidden and
                    refused, so control of an admin's mailbox is no longer enough to gain access. An admin who forgets
                    their password is then reset by another administrator (Host Admins / Tenant Admins). Recommended off
                    once you've set up 2FA and have more than one administrator.
                </p>
            </div>

            <div class="settings-group">
                <div class="settings-group-title">Abuse protection</div>
                <div class="form-group" style="margin-bottom:0;">
                    <BbLabel For="signup-attempts-per-ip-per-hour">Signup attempts per IP per hour</BbLabel>
                    <div class="row-flex">
                        <BbInput Id="signup-attempts-per-ip-per-hour" Type="InputType.Number" @bind-Value="signupMaxPerHour" />
                        <BbButton Variant="ButtonVariant.Default" @onclick="SaveThrottleAsync" Disabled="@busy">
                            <LucideIcon Name="save" /> Save
                        </BbButton>
                    </div>
                    <p class="text-muted" style="font-size:0.8rem;margin-top:0.5rem;margin-bottom:0;">
                        Abuse limit on the anonymous signup page, per client IP. Set to <span class="mono">0</span> to disable the throttle.
                    </p>
                </div>
            </div>

            @if (validationError is not null)
            {
                <p class="form-error" role="alert">@validationError</p>
            }
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <p class="text-muted" style="margin-top:0.5rem;" role="status">@statusMessage</p>
            }
        </BbCardContent>
    </BbCard>
}

@code {
    private bool signupEnabled;
    private string? signupFromAddress;
    private string signupMaxPerHour = "5";
    private bool emailRecoveryEnabled = true;
    private bool isLoading = true;
    private bool fromAddressConfigured;
    private string? statusMessage;
    private string? validationError;
    private bool busy;

    /// <summary>
    /// Runs one settings change with the page-wide double-submit guard: the flag is set before the first await,
    /// and an unexpected failure is logged and shown as a generic message.
    /// </summary>
    private async Task RunAsync(string what, Func<IPortalSettingsService, Task> action)
    {
        if (busy) return;
        busy = true;
        statusMessage = null;
        validationError = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider.GetRequiredService<IPortalSettingsService>());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the signup setting {Setting} failed", what);
            statusMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var portal = await scope.ServiceProvider.GetRequiredService<IPortalSettingsService>().GetAsync();
        signupEnabled = portal.SelfServiceSignupEnabled;
        signupFromAddress = portal.SignupFromAddress;
        signupMaxPerHour = portal.SignupMaxAttemptsPerIpPerHour.ToString();
        emailRecoveryEnabled = portal.EmailRecoveryEnabled;
        UpdateFromAddressConfigured();
        isLoading = false;
    }

    private Task OnEmailRecoveryToggleAsync(bool value) => RunAsync("EmailRecoveryEnabled", async portal =>
    {
        await portal.SetEmailRecoveryEnabledAsync(value);
        emailRecoveryEnabled = value;
        statusMessage = value ? "Email sign-in link & password reset enabled." : "Email sign-in link & password reset disabled.";
    });

    // The effective from-address is the DB value if set, otherwise the appsettings fallback. When both are
    // blank, no system email (verification, password reset, sign-in link) can be sent.
    private void UpdateFromAddressConfigured()
        => fromAddressConfigured = !string.IsNullOrWhiteSpace(signupFromAddress)
            || !string.IsNullOrWhiteSpace(UiOptions.Value.SignupFromAddress);

    private Task OnToggleAsync(bool value) => RunAsync("SelfServiceSignupEnabled", async portal =>
    {
        await portal.SetSelfServiceSignupEnabledAsync(value);
        signupEnabled = value;
        statusMessage = value ? "Self-service signup enabled." : "Self-service signup disabled.";
    });

    private Task SaveFromAddressAsync()
    {
        var from = signupFromAddress?.Trim();
        if (!string.IsNullOrEmpty(from) && !InputValidation.IsPlausibleEmail(from))
        {
            validationError = $"'{from}' is not a valid email address.";
            statusMessage = null;
            return Task.CompletedTask;
        }

        return RunAsync("SignupFromAddress", async portal =>
        {
            await portal.SetSignupFromAddressAsync(string.IsNullOrEmpty(from) ? null : from);
            signupFromAddress = from;
            UpdateFromAddressConfigured();
            statusMessage = string.IsNullOrEmpty(from)
                ? "From-address cleared (using the appsettings value)."
                : $"From-address set to {from}.";
        });
    }

    private Task SaveThrottleAsync()
    {
        // No silent fallback to 0 (= throttle off) on a typo: report it and save nothing.
        if (!InputValidation.TryParseInt(signupMaxPerHour, "Signup attempts per IP per hour", 0, 10_000, out var max, out var error))
        {
            validationError = error;
            statusMessage = null;
            return Task.CompletedTask;
        }

        return RunAsync("SignupMaxAttemptsPerIpPerHour", async portal =>
        {
            await portal.SetSignupMaxAttemptsPerIpPerHourAsync(max);
            signupMaxPerHour = max.ToString();
            statusMessage = max == 0
                ? "Signup throttle disabled."
                : $"Signup throttle set to {max}/hour per IP.";
        });
    }
}
