@page "/connectors/send/new"
@page "/connectors/send/{Id:int}"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.AdminFull)]
@inject ITenantScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject ILogger<SendConnectorDetail> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/connectors/send">Send Connectors</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(IsNew ? "New" : name)</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>@(IsNew ? "New send connector" : $"Send connector: {name}")</h1>
    <p>Outbound delivery route &mdash; smart host or direct MX delivery</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else if (notFound)
{
    <p class="text-danger">Send connector not found.</p>
    <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel"><LucideIcon Name="arrow-left" /> Back</BbButton>
}
else
{
    <BbCard>
        <BbCardContent>
            @if (isBrevo)
            {
                <div style="border:1px solid var(--border);border-radius:var(--radius);padding:0.75rem 1rem;background:var(--muted);margin-bottom:1rem;font-size:0.85rem;line-height:1.55;">
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
                        <LucideIcon Name="mail-check" Size="16" />
                        <strong>Brevo smart host</strong>
                    </div>
                    <span class="text-muted">
                        Host, port and TLS are pre-filled. Enter your <strong>Brevo account email</strong> as
                        <em>Username</em> and a <strong>Brevo SMTP key</strong> as <em>Password</em> (Brevo dashboard →
                        <em>SMTP &amp; API → SMTP</em>; the SMTP key is not your login password). Set <em>Default</em> to
                        <em>Yes</em> to route all of this tenant's outbound mail through Brevo, or add a Domain Route
                        for specific sender domains. Free tier: 300 emails/day; paid plans offer higher volume and a
                        dedicated IP — see <a href="https://www.brevo.com/pricing/" target="_blank" rel="noopener noreferrer">Brevo pricing</a>.
                    </span>
                </div>
            }
            <div class="form-grid">
                <div class="form-group col-span-full">
                    <BbLabel For="name">Name</BbLabel>
                    <BbInput Id="name" @bind-Value="name" Placeholder="Default" />
                </div>
                <div class="form-group col-span-full">
                    <BbLabel For="smart-host">Smart Host (empty = direct MX)</BbLabel>
                    <BbInput Id="smart-host" @bind-Value="smartHost" Placeholder="smtp.example.com" />
                </div>
                <div class="form-group">
                    <BbLabel For="port">Port</BbLabel>
                    <BbInput Id="port" Type="InputType.Number" @bind-Value="port" />
                </div>
                <div class="form-group">
                    <BbLabel For="username">Username</BbLabel>
                    <BbInput Id="username" @bind-Value="username" />
                </div>
                <div class="form-group">
                    <BbLabel For="password">Password</BbLabel>
                    @* The stored password is never sent to the browser: the field starts empty and a blank value
                       keeps the stored one (SendConnectorService.UpdateAsync treats null as «keep»). *@
                    <BbInput Id="password" Type="InputType.Password" @bind-Value="password" Disabled="@removePassword"
                             Placeholder="@(hasStoredPassword && !removePassword ? "•••••••• (stored)" : "")" autocomplete="new-password" />
                    @if (hasStoredPassword && removePassword)
                    {
                        <p class="hint">
                            The stored password will be removed when you save.
                        </p>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => removePassword = false">
                            <LucideIcon Name="undo-2" /> Keep the stored password
                        </BbButton>
                    }
                    else if (hasStoredPassword)
                    {
                        <p class="hint">
                            A password is stored. Leave blank to keep the current password; type a new one to replace it.
                        </p>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="MarkPasswordForRemoval">
                            <LucideIcon Name="trash-2" /> Remove stored password
                        </BbButton>
                    }
                </div>
                <div class="form-group">
                    <BbLabel For="opportunistic-tls">Opportunistic TLS</BbLabel>
                    <BbNativeSelect Id="opportunistic-tls" @bind-Value="opportunisticTls">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </BbNativeSelect>
                </div>
                <div class="form-group">
                    <BbLabel For="require-tls">Require TLS</BbLabel>
                    <BbNativeSelect Id="require-tls" @bind-Value="requireTls">
                        <option value="false">No</option>
                        <option value="true">Yes</option>
                    </BbNativeSelect>
                </div>
                <div class="form-group col-span-full">
                    <div style="display:flex;gap:0.75rem;align-items:center;">
                        <input type="checkbox" id="allow-plaintext-auth" checked="@allowPlaintextAuth"
                               @onchange="@(e => allowPlaintextAuth = e.Value is true)" style="width:1.1rem;height:1.1rem;flex-shrink:0;" />
                        <label for="allow-plaintext-auth">Allow sign-in without TLS</label>
                    </div>
                    @if (allowPlaintextAuth)
                    {
                        <div class="badge-status badge-warning" role="note" style="display:block;padding:0.6rem 0.75rem;line-height:1.45;margin-top:0.5rem;">
                            <strong>The password would travel unencrypted.</strong> When the smart host offers no TLS, the
                            relay still sends the username and password, readable by anyone on the network path. Only for a
                            smart host on a trusted local network.
                        </div>
                    }
                    else
                    {
                        <span class="hint">Off: the relay never sends the password over a connection without TLS.</span>
                    }
                </div>
                <div class="form-group">
                    <BbLabel For="default">Default</BbLabel>
                    <BbNativeSelect Id="default" @bind-Value="isDefault">
                        <option value="false">No</option>
                        <option value="true">Yes</option>
                    </BbNativeSelect>
                </div>
                <div class="form-group">
                    <BbLabel For="concurrent-deliveries">Concurrent Deliveries</BbLabel>
                    <BbInput Id="concurrent-deliveries" Type="InputType.Number" @bind-Value="concurrency" />
                </div>
                <div class="form-group">
                    <BbLabel For="max-retry-hours">Max Retry Hours</BbLabel>
                    <BbInput Id="max-retry-hours" Type="InputType.Number" @bind-Value="maxRetry" />
                </div>
                <div class="form-group col-span-full">
                    <BbLabel For="retry-intervals">Retry Intervals (minutes, comma-separated)</BbLabel>
                    <BbInput Id="retry-intervals" @bind-Value="retryIntervals" Placeholder="1,5,30,120,480,1440" />
                </div>
                <div class="form-group col-span-full">
                    <BbLabel For="ehlo-domain">EHLO hostname override (empty = host default)</BbLabel>
                    <BbInput Id="ehlo-domain" @bind-Value="ehloDomain" Placeholder="relay.example.com" />
                    <span class="hint">
                        Announced in EHLO/HELO for deliveries through this connector. Only needed when this
                        connector sends from a different egress IP than the host default &mdash; use the FQDN
                        matching that IP's PTR record. Empty uses the public hostname from Settings &rarr; Sending identity.
                    </span>
                </div>
                <div class="form-group">
                    <BbLabel For="enabled">Enabled</BbLabel>
                    <BbNativeSelect Id="enabled" @bind-Value="enabled">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </BbNativeSelect>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }
        </BbCardContent>
        <BbCardFooter>
            <div class="flex gap-1 items-center">
                <BbButton Variant="ButtonVariant.Default" @onclick="SaveAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(name))">
                    <LucideIcon Name="save" /> Save
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel">Cancel</BbButton>
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <span class="status-note" role="status">@statusMessage</span>
                }
            </div>
        </BbCardFooter>
    </BbCard>
}

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>Optional connector template to pre-fill a New connector (e.g. "brevo").</summary>
    [SupplyParameterFromQuery] public string? Template { get; set; }

    private bool IsNew => Id is null;
    private bool isBrevo;

    private bool isLoading = true;
    private bool notFound;
    private string? statusMessage;
    private string? errorMessage;
    private bool busy;
    private bool hasStoredPassword;
    // Explicit «remove stored password»: saves "" (clear). A blank field alone saves null (keep).
    private bool removePassword;

    private void MarkPasswordForRemoval()
    {
        removePassword = true;
        password = "";
    }

    private string name = "";
    private string smartHost = "";
    private string port = "587";
    private string username = "";
    private string password = "";
    private string opportunisticTls = "true";
    private string requireTls = "false";
    private bool allowPlaintextAuth;
    private int connectTimeoutSeconds = 30;
    private string isDefault = "false";
    private string concurrency = "4";
    private string maxRetry = "48";
    private string retryIntervals = "1,5,30,120,480,1440";
    private string enabled = "true";
    private string ehloDomain = "";

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            if (string.Equals(Template, "brevo", StringComparison.OrdinalIgnoreCase))
            {
                // Pre-fill the Brevo smart-host settings; the admin supplies their account email +
                // SMTP key. Require TLS — Brevo always offers STARTTLS on 587, so enforce encryption.
                isBrevo = true;
                name = "Brevo";
                smartHost = "smtp-relay.brevo.com";
                port = "587";
                opportunisticTls = "true";
                requireTls = "true";
            }
            isLoading = false;
            return;
        }

        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<ISendConnectorService>();
        var c = await svc.GetByIdAsync(Id!.Value);
        if (c is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        name = c.Name;
        smartHost = c.SmartHost ?? "";
        port = c.SmartHostPort.ToString();
        username = c.Username ?? "";
        // Never bind the stored (decrypted) password into the page: only remember that one exists.
        hasStoredPassword = !string.IsNullOrEmpty(c.EncryptedPassword);
        password = "";
        opportunisticTls = c.OpportunisticTls.ToString().ToLowerInvariant();
        requireTls = c.RequireTls.ToString().ToLowerInvariant();
        allowPlaintextAuth = c.AllowPlaintextAuth;
        connectTimeoutSeconds = c.ConnectTimeoutSeconds;
        isDefault = c.IsDefault.ToString().ToLowerInvariant();
        concurrency = c.MaxConcurrentDeliveries.ToString();
        maxRetry = c.MaxRetryHours.ToString();
        retryIntervals = c.RetryIntervalsMinutes;
        enabled = c.IsEnabled.ToString().ToLowerInvariant();
        ehloDomain = c.EhloDomain ?? "";
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        errorMessage = null;

        // Validate everything first — no silent fallback to defaults on unparsable numbers.
        string? host = null;
        if (!string.IsNullOrWhiteSpace(smartHost))
        {
            var h = smartHost.Trim().TrimEnd('.');
            if (InputValidation.IsIpAddress(h))
                host = h;
            else if (InputValidation.TryNormalizeDomain(h, out var hostAscii, out _))
                host = hostAscii;
            else
            {
                errorMessage = $"Smart host: '{h}' is not a valid host name or IP address.";
                return;
            }
        }
        if (!InputValidation.TryParseInt(port, "Port", 1, 65535, out var portValue, out var err)
            || !InputValidation.TryParseInt(concurrency, "Concurrent deliveries", 1, 100, out var concValue, out err)
            || !InputValidation.TryParseInt(maxRetry, "Max retry hours", 1, 720, out var maxRetryValue, out err)
            || !InputValidation.TryParseRetryIntervals(retryIntervals, out var intervals, out err))
        {
            errorMessage = err;
            return;
        }
        string? ehlo = null;
        if (!string.IsNullOrWhiteSpace(ehloDomain))
        {
            if (!InputValidation.TryNormalizeDomain(ehloDomain, out var ehloAscii, out var ehloError))
            {
                errorMessage = "EHLO hostname: " + ehloError;
                return;
            }
            ehlo = ehloAscii;
        }

        busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<ISendConnectorService>();

            var connector = new SendConnector
            {
                Id = Id ?? 0,
                Name = name.Trim(),
                SmartHost = host,
                SmartHostPort = portValue,
                Username = string.IsNullOrWhiteSpace(username) ? null : username.Trim(),
                // Blank = keep the stored password (null); "" = the explicit «remove stored password» (clear);
                // anything else replaces it. The stored value never left the server.
                EncryptedPassword = removePassword ? "" : string.IsNullOrEmpty(password) ? null : password,
                OpportunisticTls = opportunisticTls == "true",
                RequireTls = requireTls == "true",
                AllowPlaintextAuth = allowPlaintextAuth,
                IsDefault = isDefault == "true",
                MaxConcurrentDeliveries = concValue,
                MaxRetryHours = maxRetryValue,
                RetryIntervalsMinutes = intervals,
                // Not editable here: keep what is stored (30 s for a new connector).
                ConnectTimeoutSeconds = connectTimeoutSeconds,
                IsEnabled = enabled == "true",
                EhloDomain = ehlo
            };

            if (IsNew)
                await svc.CreateAsync(connector);
            else
                await svc.UpdateAsync(connector);

            password = "";
            Nav.NavigateTo("/connectors/send");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving send connector {ConnectorId} failed", Id);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/connectors/send");
}
