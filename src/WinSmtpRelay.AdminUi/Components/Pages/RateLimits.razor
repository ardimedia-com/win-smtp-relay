@page "/rate-limits"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.HostAdmin)]
@inject ITenantScopeFactory ScopeFactory
@inject ILogger<RateLimits> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem>
            <BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink>
        </BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem>
            <BbBreadcrumbPage>Rate Limits</BbBreadcrumbPage>
        </BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header page-header-row">
    <div>
        <h1>Rate Limits &amp; Auto-Ban</h1>
        <p>Host-wide rate limiting and failed authentication ban settings</p>
    </div>
    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => showHelp = true">
        <LucideIcon Name="info" /> About Rate Limits
    </BbButton>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else
{
    <BbCard>
        <BbCardHeader>
            <BbCardTitle>Rate Limit Settings</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <div class="form-grid">
                <div class="form-group">
                    <BbLabel For="max-connections-per-ip-per-minute">Max Connections per IP per Minute</BbLabel>
                    <BbInput Id="max-connections-per-ip-per-minute" Type="InputType.Number" @bind-Value="maxConnPerIp" />
                </div>
                <div class="form-group">
                    <BbLabel For="max-messages-per-sender-per-minute">Max Messages per Sender per Minute</BbLabel>
                    <BbInput Id="max-messages-per-sender-per-minute" Type="InputType.Number" @bind-Value="maxMsgPerMin" />
                </div>
                <div class="form-group">
                    <BbLabel For="max-messages-per-sender-per-day">Max Messages per Sender per Day</BbLabel>
                    <BbInput Id="max-messages-per-sender-per-day" Type="InputType.Number" @bind-Value="maxMsgPerDay" />
                </div>
                <div class="form-group">
                    <BbLabel For="failed-auth-ban-threshold">Failed Auth Ban Threshold (attempts)</BbLabel>
                    <BbInput Id="failed-auth-ban-threshold" Type="InputType.Number" @bind-Value="banThreshold" />
                </div>
                <div class="form-group">
                    <BbLabel For="failed-auth-ban-duration">Failed Auth Ban Duration (minutes)</BbLabel>
                    <BbInput Id="failed-auth-ban-duration" Type="InputType.Number" @bind-Value="banMinutes" />
                </div>
            </div>
            <p class="hint">A connection or message limit of 0 switches that limit off.</p>
            @if (validationError is not null)
            {
                <p class="form-error" role="alert">@validationError</p>
            }
        </BbCardContent>
        <BbCardFooter>
            <BbButton Variant="ButtonVariant.Default" @onclick="SaveAsync" Disabled="@saving">
                <LucideIcon Name="save" /> @(saving ? "Saving…" : "Save")
            </BbButton>
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <span class="status-note" role="status">@statusMessage</span>
            }
        </BbCardFooter>
    </BbCard>
}

<BbDialog @bind-Open="showHelp">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>About Rate Limits</BbDialogTitle>
            <BbDialogDescription>How rate limiting and auto-ban protect your relay</BbDialogDescription>
        </BbDialogHeader>
        <div class="dialog-body">
            <p>Rate limits prevent abuse by throttling connections and messages from any single source.</p>
            <h3>Connection Limits</h3>
            <p>Limits how many TCP connections a single IP address can open per minute.</p>
            <h3>Message Limits</h3>
            <p>Limits how many messages a single sender address can submit per minute and per day.</p>
            <h3>Auto-Ban</h3>
            <p>After the configured number of failed authentication attempts, the source IP is temporarily banned for the configured duration.</p>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Close</BbButton>
            </BbDialogClose>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private bool isLoading = true;
    private bool showHelp;
    private string? statusMessage;
    private string? validationError;
    private bool saving;

    private string maxConnPerIp = "30";
    private string maxMsgPerMin = "20";
    private string maxMsgPerDay = "1000";
    private string banThreshold = "5";
    private string banMinutes = "30";

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IRateLimitSettingsService>();
        var s = await svc.GetAsync();

        maxConnPerIp = s.MaxConnectionsPerIpPerMinute.ToString();
        maxMsgPerMin = s.MaxMessagesPerSenderPerMinute.ToString();
        maxMsgPerDay = s.MaxMessagesPerSenderPerDay.ToString();
        banThreshold = s.FailedAuthBanThreshold.ToString();
        banMinutes = s.FailedAuthBanMinutes.ToString();
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (saving) return;                                  // double-submit guard (before the first await)
        statusMessage = null;

        // No silent fallback: an unparsable or negative value is reported, nothing is saved.
        if (!InputValidation.TryParseInt(maxConnPerIp, "Max connections per IP per minute", 0, 100_000, out var connPerIp, out validationError)
            || !InputValidation.TryParseInt(maxMsgPerMin, "Max messages per sender per minute", 0, 100_000, out var msgPerMin, out validationError)
            || !InputValidation.TryParseInt(maxMsgPerDay, "Max messages per sender per day", 0, 10_000_000, out var msgPerDay, out validationError)
            || !InputValidation.TryParseInt(banThreshold, "Failed auth ban threshold", 1, 1_000, out var threshold, out validationError)
            || !InputValidation.TryParseInt(banMinutes, "Failed auth ban duration", 1, 525_600, out var minutes, out validationError))
            return;

        saving = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IRateLimitSettingsService>();

            await svc.UpdateAsync(new RateLimitSettings
            {
                Id = 1,
                MaxConnectionsPerIpPerMinute = connPerIp,
                MaxMessagesPerSenderPerMinute = msgPerMin,
                MaxMessagesPerSenderPerDay = msgPerDay,
                FailedAuthBanThreshold = threshold,
                FailedAuthBanMinutes = minutes
            });

            statusMessage = "Settings saved";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the rate limit settings failed");
            statusMessage = UiMessages.Unexpected;
        }
        finally
        {
            saving = false;
        }
    }
}
