@page "/queue"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@using Microsoft.EntityFrameworkCore
@inject ITenantScopeFactory ScopeFactory
@inject NavigationManager Navigation
@inject IActivityFeed Feed
@inject ICurrentTenant CurrentTenant
@inject IAuthorizationService AuthorizationService
@inject ILogger<Queue> Logger
@implements IDisposable

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem>
            <BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink>
        </BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem>
            <BbBreadcrumbPage>Queue</BbBreadcrumbPage>
        </BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header page-header-row">
    <div>
        <h1>Message Queue</h1>
        <p>Queued, pending, and failed messages</p>
    </div>
    <div class="row-flex">
        <BbButton Variant="ButtonVariant.Default" Disabled="@refreshing" @onclick="ManualRefreshAsync">
            <LucideIcon Name="refresh-cw" /> Refresh
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => showHelp = true">
            <LucideIcon Name="info" /> About this page
        </BbButton>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <BbAlert Class="mb-1" role="status">@statusMessage</BbAlert>
}

@if (!loaded)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else
{
    <BbTable Data="@messages">
        <BbTableHeader>
            <BbTableRow TData="QueuedMessageSummary">
                <BbTableHeaderCell TData="QueuedMessageSummary">ID</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Message-ID</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Sender</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Recipients</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Size</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Status</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Retries</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Created</BbTableHeaderCell>
                <BbTableHeaderCell TData="QueuedMessageSummary">Actions</BbTableHeaderCell>
            </BbTableRow>
        </BbTableHeader>
        <BbTableBody>
            @if (messages.Count == 0)
            {
                <BbTableRow TData="QueuedMessageSummary">
                    <BbTableCell colspan="9" class="text-muted" style="text-align:center;">Queue is empty</BbTableCell>
                </BbTableRow>
            }
            @foreach (var msg in messages)
            {
                <BbTableRow Item="@msg">
                    <BbTableCell class="mono">@msg.Id</BbTableCell>
                    <BbTableCell>
                        <span class="mono truncate-inline" title="@msg.MessageId">@msg.MessageId</span>
                    </BbTableCell>
                    <BbTableCell class="wrap-anywhere">@msg.Sender</BbTableCell>
                    <BbTableCell class="wrap-anywhere">@msg.Recipients</BbTableCell>
                    <BbTableCell class="nowrap">@FormatSize(msg.SizeBytes)</BbTableCell>
                    <BbTableCell><span class="badge-status @GetBadgeCss(msg.Status)">@msg.Status</span></BbTableCell>
                    <BbTableCell>@msg.RetryCount</BbTableCell>
                    <BbTableCell class="nowrap"><LocalTime Utc="@msg.CreatedUtc" /></BbTableCell>
                    <BbTableCell>
                        <div class="list-row-actions">
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Details / resend"
                                      aria-label="@($"Details of message {msg.Id}")"
                                      @onclick="@(() => Navigation.NavigateTo($"/messages/{msg.Id}"))">
                                <LucideIcon Name="mail" />
                            </BbButton>
                            @* Retry and Delete change the queue: AdminFull only (a viewer sees the list, not the actions).
                               The handlers re-check the policy — hiding the button alone is not a permission check. *@
                            <AuthorizeView Policy="@AuthorizationPolicies.AdminFull" Context="rowAuth">
                                @if (msg.Status is MessageStatus.Failed or MessageStatus.Bounced)
                                {
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Retry"
                                              aria-label="@($"Retry message {msg.Id}")" Disabled="@busy"
                                              @onclick="() => RetryAsync(msg.Id)">
                                        <LucideIcon Name="rotate-ccw" />
                                    </BbButton>
                                }
                                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Delete"
                                          aria-label="@($"Delete message {msg.Id}")" Disabled="@busy"
                                          @onclick="() => { deleteTargetId = msg.Id; showDeleteConfirm = true; }">
                                    <LucideIcon Name="trash-2" />
                                </BbButton>
                            </AuthorizeView>
                        </div>
                    </BbTableCell>
                </BbTableRow>
            }
        </BbTableBody>
    </BbTable>

    @if (totalCount > messages.Count)
    {
        <div class="list-footer">
            <span>Showing the newest @messages.Count of @totalCount messages.</span>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@refreshing" @onclick="LoadMoreAsync">
                Load @PageSize more
            </BbButton>
        </div>
    }
}

<BbAlertDialog @bind-Open="showDeleteConfirm">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Delete message @deleteTargetId</BbAlertDialogTitle>
            <BbAlertDialogDescription>This will permanently remove the message from the queue. This action cannot be undone.</BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" Disabled="@busy" @onclick="ConfirmDeleteAsync">Delete</BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

<BbDialog @bind-Open="showHelp">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>About the Message Queue</BbDialogTitle>
            <BbDialogDescription>Understanding message processing</BbDialogDescription>
        </BbDialogHeader>
        <div class="dialog-body">
            <p>
                Every email submitted to WIN-SMTP-RELAY is first stored in a persistent queue (SQLite database)
                before delivery is attempted. This page shows messages that are waiting, being delivered, or have failed.
            </p>
            <h3>Message lifecycle</h3>
            <ol>
                <li><strong>Queued</strong> &mdash; message received and waiting for the delivery worker to pick it up.</li>
                <li><strong>Delivering</strong> &mdash; currently being sent to the recipient's mail server.</li>
                <li><strong>Delivered</strong> &mdash; successfully accepted by the remote server (disappears from this view).</li>
                <li><strong>Failed/Bounced</strong> &mdash; delivery failed permanently after all retry attempts.</li>
            </ol>
            <h3>Actions</h3>
            <ul>
                <li><strong>Retry</strong> &mdash; re-queue a failed/bounced message for another delivery attempt.</li>
                <li><strong>Delete</strong> &mdash; permanently remove a message from the queue.</li>
            </ul>
            <h3>Retries</h3>
            <p>
                The relay automatically retries delivery on temporary failures using configurable intervals
                (e.g., 1, 5, 15, 30, 60 minutes). After the maximum retry window (default 48 hours),
                the message is bounced.
            </p>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Close</BbButton>
            </BbDialogClose>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private const int PageSize = 100;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool showHelp;
    private IReadOnlyList<QueuedMessageSummary> messages = [];
    private int totalCount;
    private int take = PageSize;
    private string? statusMessage;
    private bool loaded;
    private bool refreshing;
    private bool busy;
    private bool showDeleteConfirm;
    private long deleteTargetId;
    private bool _disposed;

    // Feed events and user actions can both trigger a reload; one at a time, so two loads never
    // interleave their results.
    private readonly SemaphoreSlim _loadLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        Feed.Received += OnActivity;
    }

    private void OnActivity(ActivityEvent e)
    {
        // The queue changes when a message is queued, delivered, or removed; refresh on those signals.
        // RefreshAsync re-reads only this circuit's tenant queue, so reacting to a broadcast is harmless.
        if (e.Kind is ActivityKind.QueueChanged
            || (e.Kind is ActivityKind.MessageReceived && CurrentTenant.Owns(e)))
            RefreshInBackground();
    }

    private void RefreshInBackground()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // A background refresh must never escape: the event fires on a feed thread.
                Logger.LogWarning(ex, "Background refresh of the queue page failed");
            }
        });
    }

    private async Task ManualRefreshAsync()
    {
        statusMessage = null;
        await RefreshAsync();
    }

    private async Task LoadMoreAsync()
    {
        take += PageSize;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        await _loadLock.WaitAsync();
        refreshing = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var queue = scope.ServiceProvider.GetRequiredService<IMessageQueue>();
            // Body-free summaries: a list never loads message content.
            messages = await queue.GetSummariesAsync(take, nonDeliveredOnly: true);
            var db = scope.ServiceProvider.GetRequiredService<RelayDbContext>();
            totalCount = await db.QueuedMessages.CountAsync(m => m.Status != MessageStatus.Delivered);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the message queue failed");
            statusMessage = UiMessages.Unexpected;
        }
        finally
        {
            loaded = true;
            refreshing = false;
            _loadLock.Release();
        }
    }

    private async Task RetryAsync(long id)
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        busy = true;
        try
        {
            if (!await AuthorizationService.IsAllowedAsync(AuthState, AuthorizationPolicies.AdminFull))
            {
                statusMessage = UiMessages.Forbidden;
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var queue = scope.ServiceProvider.GetRequiredService<IMessageQueue>();
            // RequeueAsync (not the raw status/retry plumbing): the admin operation validates the state
            // transition and audits the action.
            statusMessage = await queue.RequeueAsync(id)
                ? $"Message {id} re-queued for delivery"
                : $"Message {id} is not in a retryable state";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Re-queueing message {MessageId} failed", id);
            statusMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        busy = true;
        var id = deleteTargetId;
        try
        {
            if (!await AuthorizationService.IsAllowedAsync(AuthState, AuthorizationPolicies.AdminFull))
            {
                statusMessage = UiMessages.Forbidden;
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var queue = scope.ServiceProvider.GetRequiredService<IMessageQueue>();
            await queue.DeleteAsync(id);
            statusMessage = $"Message {id} deleted";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting message {MessageId} failed", id);
            statusMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
            showDeleteConfirm = false;
        }
    }

    private static string FormatSize(int bytes)
    {
        if (bytes is >= 0 and <= 1023) return $"{bytes} B";
        if (bytes is >= 1024 and <= 1048575) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private static string GetBadgeCss(MessageStatus status) => status switch
    {
        MessageStatus.Delivered => "badge-success",
        MessageStatus.Delivering => "badge-warning",
        MessageStatus.Failed or MessageStatus.Bounced => "badge-error",
        MessageStatus.Queued => "badge-muted",
        _ => "badge-muted"
    };

    public void Dispose()
    {
        _disposed = true;
        Feed.Received -= OnActivity;
    }
}
