@page "/ip-rules/new"
@page "/ip-rules/{Id:int}"
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.AdminFull)]
@inject ITenantScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject ILogger<IpAccessRuleDetail> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/ip-rules">IP Access Rules</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(IsNew ? "New" : network)</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>@(IsNew ? "New IP rule" : $"IP rule: {network}")</h1>
    <p>Network-level allow and deny rule, evaluated in sort order</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else if (notFound)
{
    <p class="text-danger">IP access rule not found.</p>
    <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel"><LucideIcon Name="arrow-left" /> Back</BbButton>
}
else
{
    <BbCard>
        <BbCardContent>
            <div class="form-grid">
                <div class="form-group">
                    <BbLabel For="network">Network (CIDR)</BbLabel>
                    <BbInput Id="network" @bind-Value="network" Placeholder="10.0.0.0/8" />
                    <p class="hint">A single address (192.168.1.10) or a network in CIDR notation (192.168.1.0/24, 2001:db8::/48).</p>
                </div>
                <div class="form-group">
                    <BbLabel For="action">Action</BbLabel>
                    <BbNativeSelect Id="action" @bind-Value="action">
                        <option value="Allow">Allow</option>
                        <option value="Deny">Deny</option>
                    </BbNativeSelect>
                </div>
                <div class="form-group">
                    <BbLabel For="sort-order">Sort Order</BbLabel>
                    <BbInput Id="sort-order" Type="InputType.Number" @bind-Value="sortOrder" />
                </div>
                <div class="form-group col-span-full">
                    <BbLabel For="description">Description (optional)</BbLabel>
                    <BbInput Id="description" @bind-Value="description" Placeholder="Internal network" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }
        </BbCardContent>
        <BbCardFooter>
            <div class="flex gap-1 items-center">
                <BbButton Variant="ButtonVariant.Default" @onclick="SaveAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(network))">
                    <LucideIcon Name="save" /> Save
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel">Cancel</BbButton>
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <span class="status-note" role="status">@statusMessage</span>
                }
            </div>
        </BbCardFooter>
    </BbCard>
}

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsNew => Id is null;

    private bool isLoading = true;
    private bool notFound;
    private string? statusMessage;
    private string? errorMessage;
    private bool busy;

    private string network = "";
    private string action = "Allow";
    private string sortOrder = "0";
    private string description = "";

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<IIpAccessRuleService>();
        var all = await svc.GetAllAsync();

        if (IsNew)
        {
            var nextOrder = all.Count > 0 ? all.Max(r => r.SortOrder) + 1 : 1;
            sortOrder = nextOrder.ToString();
            isLoading = false;
            return;
        }

        var rule = all.FirstOrDefault(r => r.Id == Id!.Value);
        if (rule is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        network = rule.Network;
        action = rule.Action.ToString();
        sortOrder = rule.SortOrder.ToString();
        description = rule.Description ?? "";
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        errorMessage = null;

        // Validate before saving: a malformed CIDR fails closed at runtime (never matches), so a typo in an
        // allow rule would silently do nothing and a typo in a deny rule would silently not block.
        if (!InputValidation.TryNormalizeNetwork(network, out var normalizedNetwork, out var networkError))
        {
            errorMessage = networkError;
            return;
        }
        if (!Enum.TryParse<IpAccessAction>(action, out var parsedAction))
        {
            errorMessage = "Select an action (Allow or Deny).";
            return;
        }
        if (!InputValidation.TryParseInt(sortOrder, "Sort order", 0, int.MaxValue, out var order, out var orderError))
        {
            errorMessage = orderError;
            return;
        }

        busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IIpAccessRuleService>();

            var rule = new IpAccessRule
            {
                Id = Id ?? 0,
                Network = normalizedNetwork,
                Action = parsedAction,
                SortOrder = order,
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim()
            };

            if (IsNew)
                await svc.CreateAsync(rule);
            else
                await svc.UpdateAsync(rule);

            Nav.NavigateTo("/ip-rules");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving IP access rule {Network} failed", normalizedNetwork);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/ip-rules");
}
