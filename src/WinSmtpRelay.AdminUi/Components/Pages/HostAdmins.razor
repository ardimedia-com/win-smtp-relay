@page "/host/admins"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.HostAdmin)]
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject ILogger<HostAdmins> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>Host Admins</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header page-header-row">
    <div>
        <h1>Host Admins</h1>
        <p>Host-level administrators — full host administration (tenants, server config). A host admin has
           no tenant access by default; tenant access is granted per tenant (see Tenant Admins).</p>
    </div>
    <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" @onclick="StartCreate" Disabled="@creating">
        <LucideIcon Name="user-plus" /> New host admin
    </BbButton>
</div>

@if (errorMessage is not null)
{
    <div class="account-error" role="alert">@errorMessage</div>
}

@if (createdPassword is not null)
{
    <BbCard>
        <BbCardHeader><BbCardTitle>Host admin created</BbCardTitle></BbCardHeader>
        <BbCardContent>
            <div class="badge-status badge-warning" style="display:block;padding:0.75rem;line-height:1.5;margin-bottom:1rem;">
                <strong>Share this one-time password securely with @createdEmail. They must change it on first sign-in.</strong>
            </div>
            <div class="form-group">
                <BbLabel For="otp">One-time password</BbLabel>
                <div class="row-flex">
                    <BbInput Id="otp" Value="@createdPassword" ReadOnly="true" Class="mono" />
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="CopyAsync"><LucideIcon Name="copy" /> Copy</BbButton>
                </div>
                @if (copyStatus is not null)
                {
                    <p class="hint" role="status">@copyStatus</p>
                }
            </div>
        </BbCardContent>
        <BbCardFooter><BbButton @onclick="@(() => { createdPassword = null; copyStatus = null; })">Done</BbButton></BbCardFooter>
    </BbCard>
}
else if (creating)
{
    <BbCard>
        <BbCardContent>
            <div class="form-group">
                <BbLabel For="email">Email</BbLabel>
                <BbInput Id="email" @bind-Value="newEmail" Placeholder="admin@yourdomain.tld" />
            </div>
        </BbCardContent>
        <BbCardFooter>
            <div class="flex gap-1 items-center">
                <BbButton @onclick="CreateAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(newEmail))"><LucideIcon Name="user-plus" /> Create</BbButton>
                <BbButton Variant="ButtonVariant.Outline" @onclick="@(() => { creating = false; errorMessage = null; })">Cancel</BbButton>
            </div>
        </BbCardFooter>
    </BbCard>
}

@if (isLoading)
{
    <BbSkeleton Class="h-[200px] w-full" />
}
else
{
    <BbTable Data="@rows">
        <BbTableHeader>
            <BbTableRow TData="Row">
                <BbTableHeaderCell TData="Row">Email</BbTableHeaderCell>
                <BbTableHeaderCell TData="Row">Status</BbTableHeaderCell>
                <BbTableHeaderCell TData="Row"></BbTableHeaderCell>
            </BbTableRow>
        </BbTableHeader>
        <BbTableBody>
            @if (rows.Count == 0)
            {
                <BbTableRow TData="Row"><BbTableCell colspan="3" style="text-align:center;">No host admins</BbTableCell></BbTableRow>
            }
            @foreach (var r in rows)
            {
                <BbTableRow Item="@r">
                    <BbTableCell>@r.Email</BbTableCell>
                    <BbTableCell>
                        @switch (r.State)
                        {
                            case AccountState.Disabled:
                                <span class="badge-status badge-muted">Disabled</span>
                                break;
                            case AccountState.Locked:
                                <span class="badge-status badge-warning" title="Locked after too many failed sign-ins">Locked</span>
                                break;
                            default:
                                <span class="badge-status badge-success">Enabled</span>
                                break;
                        }
                    </BbTableCell>
                    <BbTableCell>
                        <div class="list-row-actions">
                            @if (r.IsSelf)
                            {
                                <span class="text-muted" style="font-size:0.75rem;">you</span>
                            }
                            else
                            {
                                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Reset password"
                                          AriaLabel="@($"Reset password of {r.Email}")" Disabled="@busy"
                                          @onclick="() => AskConfirm(PendingAction.Reset, r)"><LucideIcon Name="key-round" /></BbButton>
                                @if (r.State == AccountState.Locked)
                                {
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Unlock"
                                              AriaLabel="@($"Unlock {r.Email}")" Disabled="@busy"
                                              @onclick="() => UnlockAsync(r.Id)"><LucideIcon Name="lock-open" /></BbButton>
                                }
                                @if (r.State == AccountState.Disabled)
                                {
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Enable"
                                              AriaLabel="@($"Enable {r.Email}")" Disabled="@busy"
                                              @onclick="() => EnableAsync(r.Id)"><LucideIcon Name="play" /></BbButton>
                                }
                                else
                                {
                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Disable"
                                              AriaLabel="@($"Disable {r.Email}")" Disabled="@busy"
                                              @onclick="() => AskConfirm(PendingAction.Disable, r)"><LucideIcon Name="pause" /></BbButton>
                                }
                                <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" title="Delete"
                                          AriaLabel="@($"Delete {r.Email}")" Disabled="@busy"
                                          @onclick="() => { deleteId = r.Id; deleteEmail = r.Email; showDelete = true; }"><LucideIcon Name="trash-2" /></BbButton>
                            }
                        </div>
                    </BbTableCell>
                </BbTableRow>
            }
        </BbTableBody>
    </BbTable>
}

<BbAlertDialog @bind-Open="showDelete">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Delete host admin</BbAlertDialogTitle>
            <BbAlertDialogDescription>This permanently removes the login account <strong>@deleteEmail</strong> and its memberships.</BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel><BbButton Variant="ButtonVariant.Outline">Cancel</BbButton></BbAlertDialogCancel>
            <BbAlertDialogAction><BbButton Variant="ButtonVariant.Destructive" Disabled="@busy" @onclick="ConfirmDeleteAsync">Delete</BbButton></BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

<BbAlertDialog @bind-Open="showConfirm">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>@(pendingAction == PendingAction.Reset ? "Reset password" : "Disable host admin")</BbAlertDialogTitle>
            <BbAlertDialogDescription>
                @if (pendingAction == PendingAction.Reset)
                {
                    <span>The current password of <strong>@pendingEmail</strong> stops working immediately. A one-time password
                        is shown once; they must change it at the next sign-in. A lockout after failed sign-ins is lifted.</span>
                }
                else
                {
                    <span><strong>@pendingEmail</strong> can no longer sign in until an administrator enables the account again.
                        Open sessions end at their next check.</span>
                }
            </BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel><BbButton Variant="ButtonVariant.Outline">Cancel</BbButton></BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" Disabled="@busy" @onclick="ConfirmPendingAsync">
                    @(pendingAction == PendingAction.Reset ? "Reset password" : "Disable")
                </BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

@code {
    private enum AccountState { Enabled, Locked, Disabled }
    private sealed record Row(int Id, string Email, AccountState State, bool IsSelf);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Row> rows = [];
    private bool isLoading = true;
    private bool creating;
    private bool busy;
    private string newEmail = "";
    private string? createdPassword;
    private string? createdEmail;
    private string? errorMessage;
    private string? copyStatus;
    private bool showDelete;
    private int deleteId;
    private string deleteEmail = "";

    // Reset and disable lock a person out of their current access, so both go through a confirmation.
    private enum PendingAction { Reset, Disable }
    private bool showConfirm;
    private PendingAction pendingAction;
    private int pendingUserId;
    private string pendingEmail = "";

    private void AskConfirm(PendingAction action, Row row)
    {
        pendingAction = action;
        pendingUserId = row.Id;
        pendingEmail = row.Email;
        showConfirm = true;
    }

    private async Task ConfirmPendingAsync()
    {
        showConfirm = false;
        if (pendingAction == PendingAction.Reset)
            await ResetAsync(pendingUserId);
        else
            await DisableAsync(pendingUserId);
    }
    private int currentUserId;
    private string? currentEmail;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
            currentEmail = user.Identity?.Name;
        }
        await RefreshAsync();
    }

    private void StartCreate() { creating = true; createdPassword = null; errorMessage = null; newEmail = ""; }

    private async Task RefreshAsync()
    {
        isLoading = true;
        using var scope = ScopeFactory.CreateScope();
        var sp = scope.ServiceProvider;
        var um = sp.GetRequiredService<UserManager<AdminUser>>();
        var memberships = sp.GetRequiredService<IAdminMembershipService>();

        var hostUserIds = (await memberships.GetHostAsync()).Select(m => m.UserId).Distinct().ToList();
        var users = await um.Users.Where(u => hostUserIds.Contains(u.Id)).OrderBy(u => u.Email).ToListAsync();
        var now = DateTimeOffset.UtcNow;
        rows = users.Select(u => new Row(u.Id, u.Email ?? u.UserName ?? "",
            AdminAccountService.IsDisabled(u) ? AccountState.Disabled
                : AdminAccountService.IsBruteForceLocked(u, now) ? AccountState.Locked
                : AccountState.Enabled,
            u.Id == currentUserId)).ToList();
        isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (busy) return;
        var email = newEmail.Trim();
        if (!InputValidation.IsPlausibleEmail(email))
        {
            errorMessage = $"'{email}' is not a valid email address.";
            return;
        }
        busy = true;
        errorMessage = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var sp = scope.ServiceProvider;
            var um = sp.GetRequiredService<UserManager<AdminUser>>();
            var memberships = sp.GetRequiredService<IAdminMembershipService>();
            var audit = sp.GetRequiredService<IAdminAuditService>();

            if (await um.FindByEmailAsync(email) is not null)
            {
                errorMessage = "An account with that email already exists.";
                return;
            }

            var user = new AdminUser { UserName = email, Email = email, EmailConfirmed = true, MustChangePassword = true, CreatedUtc = DateTimeOffset.UtcNow };
            var password = TempPassword.Generate();
            var result = await um.CreateAsync(user, password);
            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            await memberships.GrantAsync(user.Id, null, RelayRoles.HostAdmin, currentUserId);
            await audit.WriteAsync(AdminAuditActions.AdminCreated, currentUserId, currentEmail, targetUserId: user.Id, detail: "host admin");

            createdPassword = password;
            createdEmail = email;
            creating = false;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating a host admin failed");
            errorMessage = UiMessages.Unexpected;
        }
        finally { busy = false; }
    }

    private async Task ResetAsync(int id)
    {
        if (busy) return;                                    // double-submit guard (before the first await)
        busy = true;
        errorMessage = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var sp = scope.ServiceProvider;
            var um = sp.GetRequiredService<UserManager<AdminUser>>();
            var audit = sp.GetRequiredService<IAdminAuditService>();
            var user = await um.FindByIdAsync(id.ToString());
            if (user is null || user.Id == currentUserId) return;

            var password = TempPassword.Generate();
            var token = await um.GeneratePasswordResetTokenAsync(user);
            var result = await um.ResetPasswordAsync(user, token, password);
            if (!result.Succeeded) { errorMessage = string.Join(" ", result.Errors.Select(e => e.Description)); return; }
            user.MustChangePassword = true;
            await um.UpdateAsync(user);
            await audit.WriteAsync(AdminAuditActions.AdminPasswordReset, currentUserId, currentEmail, targetUserId: user.Id);
            createdPassword = password;
            createdEmail = user.Email;
            copyStatus = null;

            // The new password is useless while a brute-force lockout runs, so the reset lifts it. An administrative
            // disable stays: re-enabling is a separate, deliberate action.
            if (AdminAccountService.IsBruteForceLocked(user, DateTimeOffset.UtcNow))
            {
                var unlock = await sp.GetRequiredService<IAdminAccountService>().UnlockAsync(user.Id, currentUserId, currentEmail);
                if (!unlock.Succeeded)
                    errorMessage = unlock.Error ?? UiMessages.Unexpected;
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resetting the password of host admin {UserId} failed", id);
            errorMessage = UiMessages.Unexpected;
        }
        finally { busy = false; }
    }

    private Task DisableAsync(int id) =>
        RunAccountActionAsync(id, "Disabling", (accounts, uid) => accounts.DisableAsync(uid, currentUserId, currentEmail));

    private Task EnableAsync(int id) =>
        RunAccountActionAsync(id, "Enabling", (accounts, uid) => accounts.EnableAsync(uid, currentUserId, currentEmail));

    private Task UnlockAsync(int id) =>
        RunAccountActionAsync(id, "Unlocking", (accounts, uid) => accounts.UnlockAsync(uid, currentUserId, currentEmail));

    // Disable / enable / unlock go through IAdminAccountService, which also ends the sessions (disable), clears the
    // failed-attempt counter and writes the audit row. The page never sets a lockout itself.
    private async Task RunAccountActionAsync(int id, string verb, Func<IAdminAccountService, int, Task<AdminAccountResult>> action)
    {
        if (busy || id == currentUserId) return;             // double-submit guard (before the first await)
        busy = true;
        errorMessage = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var result = await action(scope.ServiceProvider.GetRequiredService<IAdminAccountService>(), id);
            if (!result.Succeeded)
                errorMessage = result.Error ?? UiMessages.Unexpected;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Verb} host admin {UserId} failed", verb, id);
            errorMessage = UiMessages.Unexpected;
        }
        finally { busy = false; }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (busy) return;                                    // double-submit guard (before the first await)
        showDelete = false;
        busy = true;
        errorMessage = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var sp = scope.ServiceProvider;
            var um = sp.GetRequiredService<UserManager<AdminUser>>();
            var memberships = sp.GetRequiredService<IAdminMembershipService>();
            var audit = sp.GetRequiredService<IAdminAuditService>();
            var user = await um.FindByIdAsync(deleteId.ToString());
            if (user is null || user.Id == currentUserId) return;

            if (await memberships.CountHostAdminsAsync() <= 1)
            {
                errorMessage = "You can't delete the last host admin.";
                return;
            }
            var email = user.Email;
            await um.DeleteAsync(user); // cascades memberships + Identity rows
            await audit.WriteAsync(AdminAuditActions.AdminDeleted, currentUserId, currentEmail, targetUserId: deleteId, detail: email);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting host admin {UserId} failed", deleteId);
            errorMessage = UiMessages.Unexpected;
        }
        finally { busy = false; }
    }

    private async Task CopyAsync()
    {
        copyStatus = await JS.CopyToClipboardAsync(createdPassword) ? "Copied." : UiMessages.CopyFailed;
    }
}
