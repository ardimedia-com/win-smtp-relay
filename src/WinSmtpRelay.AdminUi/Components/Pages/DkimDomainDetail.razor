@page "/dkim/new"
@page "/dkim/{Id:int}"
@using System.Security.Cryptography
@using WinSmtpRelay.Core.Interfaces
@using WinSmtpRelay.Core.Models
@attribute [Authorize(Policy = AuthorizationPolicies.HostAdmin)]
@inject ITenantScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<DkimDomainDetail> Logger

<BbBreadcrumb>
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Home</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/dkim">DKIM</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(IsNew ? "New" : domain)</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

<div class="page-header">
    <h1>@(IsNew ? "New DKIM domain" : $"DKIM: {domain}")</h1>
    <p>A signing key pair is generated and stored in the database — no key files to manage.</p>
</div>

@if (isLoading)
{
    <BbSkeleton Class="h-[300px] w-full" />
}
else if (notFound)
{
    <p class="text-danger">DKIM domain not found.</p>
    <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel"><LucideIcon Name="arrow-left" /> Back</BbButton>
}
else
{
    <BbCard>
        <BbCardContent>
            <div class="form-group field-narrow">
                <BbLabel For="domain">Domain</BbLabel>
                <BbInput Id="domain" @bind-Value="domain" Placeholder="example.com" Disabled="@(!IsNew)" />
            </div>
            <div class="row-flex">
                <div class="form-group">
                    <BbLabel For="selector">Selector</BbLabel>
                    <BbInput Id="selector" @bind-Value="selector" Placeholder="default" />
                </div>
                @if (IsNew)
                {
                    <div class="form-group">
                        <BbLabel For="key-size">Key size</BbLabel>
                        <BbNativeSelect Id="key-size" @bind-Value="keySize">
                            <option value="2048">2048-bit</option>
                            <option value="4096">4096-bit</option>
                        </BbNativeSelect>
                    </div>
                }
                <div class="form-group">
                    <BbLabel For="enabled">Enabled</BbLabel>
                    <BbNativeSelect Id="enabled" @bind-Value="enabled">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </BbNativeSelect>
                </div>
            </div>

            @if (!IsNew && !string.IsNullOrEmpty(dnsTxt))
            {
                <div class="settings-subhead">DNS record to publish</div>
                <div class="dns-record">
                    <div class="dns-record-name mono text-muted">@(selector)._domainkey.@(domain)</div>
                    <div class="dns-record-row">
                        <span class="dns-record-label">Value</span>
                        <code class="mono dns-record-value dns-record-suggested">@dnsTxt</code>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => CopyAsync(dnsTxt)" title="Copy" aria-label="Copy the DNS record value">
                            <LucideIcon Name="copy" /> Copy
                        </BbButton>
                    </div>
                    <p class="hint">
                        Publish this TXT record at your DNS provider. Regenerating the key changes this value —
                        you must republish it.
                    </p>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@busy" @onclick="() => showRegenerateConfirm = true">
                        <LucideIcon Name="refresh-cw" /> Regenerate key…
                    </BbButton>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }
        </BbCardContent>
        <BbCardFooter>
            <div class="flex gap-1 items-center">
                <BbButton Variant="ButtonVariant.Default" @onclick="SaveAsync"
                        Disabled="@(busy || string.IsNullOrWhiteSpace(domain) || string.IsNullOrWhiteSpace(selector))">
                    <LucideIcon Name="save" /> Save
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" @onclick="Cancel">@(IsNew ? "Cancel" : "Done")</BbButton>
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <span class="status-note" role="status">@statusMessage</span>
                }
            </div>
        </BbCardFooter>
    </BbCard>
}

<BbAlertDialog @bind-Open="showRegenerateConfirm">
    <BbAlertDialogContent>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Regenerate the DKIM key for @domain?</BbAlertDialogTitle>
            <BbAlertDialogDescription>
                A new @(keyBits)-bit key pair replaces the current one immediately. Mail is signed with the new key
                from now on, so receivers fail the DKIM check until you publish the new TXT record at
                <span class="mono wrap-anywhere">@(selector)._domainkey.@(domain)</span>. The old key cannot be restored.
            </BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter>
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbAlertDialogCancel>
            <BbAlertDialogAction>
                <BbButton Variant="ButtonVariant.Destructive" Disabled="@busy" @onclick="RegenerateAsync">Regenerate key</BbButton>
            </BbAlertDialogAction>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>


@code {
    [Parameter] public int? Id { get; set; }
    private bool IsNew => Id is null;

    private bool isLoading = true;
    private bool notFound;
    private bool busy;
    private bool showRegenerateConfirm;
    private string? statusMessage;
    private string? errorMessage;

    private string domain = "";
    private string selector = "default";
    private string keySize = "2048";
    private string enabled = "true";

    // The private key is never held in this component: Save and Regenerate re-read the stored entity on the
    // server. Only what the page displays is kept — the public DNS value and the current key size.
    private string? dnsTxt;
    private int keyBits = 2048;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            isLoading = false;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IDkimDomainService>();
            var d = (await svc.GetAllAsync()).FirstOrDefault(x => x.Id == Id!.Value);
            if (d is null)
            {
                notFound = true;
                return;
            }

            domain = d.Domain;
            selector = d.Selector;
            enabled = d.IsEnabled.ToString().ToLowerInvariant();
            (dnsTxt, keyBits) = DescribeKey(d);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading DKIM domain {DkimId} failed", Id);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        errorMessage = null;

        if (!InputValidation.TryNormalizeDomain(domain, out var normalized, out var domainError))
        {
            errorMessage = domainError;
            return;
        }
        var sel = selector.Trim();
        if (!IsValidSelector(sel))
        {
            errorMessage = "Selector: use letters, digits, hyphens and dots only (e.g. default or s2026).";
            return;
        }

        busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IDkimDomainService>();

            if (IsNew)
            {
                if (await svc.GetByDomainAsync(normalized) is not null)
                {
                    errorMessage = $"DKIM for '{normalized}' already exists";
                    return;
                }

                var bits = int.TryParse(keySize, out var ks) && ks is 2048 or 4096 ? ks : 2048;
                var (priv, _, _) = WinSmtpRelay.Security.DkimKeyGenerator.GenerateKeyPair(normalized, sel, bits);

                var created = await svc.CreateAsync(new DkimDomain
                {
                    Domain = normalized,
                    Selector = sel,
                    PrivateKeyPem = priv,
                    IsEnabled = enabled == "true"
                });

                // Land on the detail page so the operator sees the DNS record to publish.
                Nav.NavigateTo($"/dkim/{created.Id}");
                return;
            }

            // Keep the stored key: copy it from the entity as it is in the database right now.
            var stored = (await svc.GetAllAsync()).FirstOrDefault(x => x.Id == Id!.Value);
            if (stored is null)
            {
                notFound = true;
                return;
            }

            await svc.UpdateAsync(new DkimDomain
            {
                Id = Id!.Value,
                Domain = normalized,
                Selector = sel,
                PrivateKeyPem = stored.PrivateKeyPem,
                PrivateKeyPath = stored.PrivateKeyPath,
                IsEnabled = enabled == "true"
            });
            Nav.NavigateTo("/dkim");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving DKIM domain {Domain} failed", normalized);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        if (busy) return;                                   // double-submit guard (before the first await)
        busy = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var normalized = domain.ToLowerInvariant().Trim();
            var sel = selector.Trim();

            // Keep the key size the domain had (a 4096-bit domain stays 4096-bit).
            var bits = keyBits is 1024 or 2048 or 3072 or 4096 ? Math.Max(keyBits, 2048) : 2048;
            var (priv, _, txt) = WinSmtpRelay.Security.DkimKeyGenerator.GenerateKeyPair(normalized, sel, bits);

            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<IDkimDomainService>();
            await svc.UpdateAsync(new DkimDomain
            {
                Id = Id!.Value,
                Domain = normalized,
                Selector = sel,
                PrivateKeyPem = priv,
                PrivateKeyPath = null, // the stored key now supersedes any legacy file
                IsEnabled = enabled == "true"
            });

            dnsTxt = txt;
            keyBits = bits;
            statusMessage = "Key regenerated — republish the DNS record above.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Regenerating the DKIM key for {Domain} failed", domain);
            errorMessage = UiMessages.Unexpected;
        }
        finally
        {
            busy = false;
            showRegenerateConfirm = false;
        }
    }

    /// <summary>The DNS TXT value and the RSA key size of the stored key (null value when it cannot be read).</summary>
    private static (string? DnsTxt, int KeyBits) DescribeKey(DkimDomain d)
    {
        try
        {
            string pem;
            if (!string.IsNullOrWhiteSpace(d.PrivateKeyPem))
                pem = d.PrivateKeyPem;
            else if (!string.IsNullOrWhiteSpace(d.PrivateKeyPath) && File.Exists(d.PrivateKeyPath))
                pem = File.ReadAllText(d.PrivateKeyPath);
            else
                return (null, 2048);

            using var rsa = RSA.Create();
            rsa.ImportFromPem(pem);
            return ("v=DKIM1; k=rsa; p=" + Convert.ToBase64String(rsa.ExportSubjectPublicKeyInfo()), rsa.KeySize);
        }
        catch
        {
            return (null, 2048);
        }
    }

    private static bool IsValidSelector(string value) =>
        value.Length is > 0 and <= 63
        && value.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '.' or '_')
        && !value.StartsWith('.') && !value.EndsWith('.');

    private async Task CopyAsync(string value)
    {
        statusMessage = await JS.CopyToClipboardAsync(value) ? "Copied." : UiMessages.CopyFailed;
    }

    private void Cancel() => Nav.NavigateTo("/dkim");
}
