@page "/account/initial-setup"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(WinSmtpRelay.AdminApi.Auth.RelayRateLimitPolicies.SignIn)]
@inject SignInManager<AdminUser> SignInManager
@inject IInitialAdminSetup Setup
@inject NavigationManager Nav
@inject ILogger<InitialSetup> Logger

@if (alreadyConfigured)
{
    <h1 class="account-title">Already set up</h1>
    <p class="account-subtitle">An administrator already exists on this relay.</p>
    <a class="account-button" href="/account/login">Go to sign in</a>
}
else
{
    <h1 class="account-title">Set up the first administrator</h1>
    <p class="account-subtitle">
        This relay has no administrator yet. Create the first one — it becomes the host administrator with
        full access to manage tenants, listeners, certificates and settings.
    </p>
    <p class="account-subtitle">
        To prove you administer this server, enter the one-time setup token. It is in the file
        <code>@(tokenFile ?? InitialSetupToken.FileName)</code> on the server, readable by Administrators only
        (the Windows Event Log names the file too). It is replaced on every service start until an administrator exists.
    </p>

    @if (errorMessage is not null)
    {
        <div class="account-error" role="alert">@errorMessage</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="initial-setup">
        <DataAnnotationsValidator />
        <div class="account-field">
            <label for="token">Setup token</label>
            <InputText id="token" @bind-Value="Input.SetupToken" autocomplete="off" class="account-input" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
            <ValidationMessage For="() => Input.SetupToken" />
        </div>
        <div class="account-field">
            <label for="name">Name</label>
            <InputText id="name" @bind-Value="Input.DisplayName" class="account-input" placeholder="Administrator" />
            <ValidationMessage For="() => Input.DisplayName" />
        </div>
        <div class="account-field">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" class="account-input" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="account-field">
            <label for="password">Password</label>
            <div class="password-field">
                <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" class="account-input" />
                <PasswordToggle />
            </div>
            <ValidationMessage For="() => Input.Password" />
        </div>
        <div class="account-field">
            <label for="confirm">Confirm password</label>
            <div class="password-field">
                <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" class="account-input" />
                <PasswordToggle />
            </div>
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit" class="account-button">Create administrator</button>
    </EditForm>
}

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? errorMessage;
    private string? tokenFile;
    private bool alreadyConfigured;

    protected override async Task OnInitializedAsync()
    {
        // First-run only: once any administrator exists, this page must not create another — redirect to
        // sign in. (Login redirects here while no account exists, so the two cannot loop.)
        if (!await Setup.IsRequiredAsync())
        {
            alreadyConfigured = true;
            Nav.NavigateTo("/account/login");
            return;
        }

        // Normally issued at service start (AdminSeeder); issued here if all administrators were removed since.
        try
        {
            tokenFile = await Setup.EnsureTokenIssuedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not write the first-run setup token");
            errorMessage = "The setup token could not be written to the data folder. Check the service's Event Log.";
        }
    }

    private async Task SubmitAsync()
    {
        // Token check, the "no administrator yet" re-check and the creation run as one serialised, transactional
        // step (IInitialAdminSetup), so neither a visitor without the token nor a concurrent request can create one.
        var result = await Setup.CreateFirstAdminAsync(Input.SetupToken, Input.Email.Trim(), Input.DisplayName, Input.Password);
        if (result.AlreadyConfigured)
        {
            alreadyConfigured = true;
            return;
        }
        if (!result.Succeeded || result.User is null)
        {
            errorMessage = result.Error;
            return;
        }

        // Session cookie (not persistent): first-run setup has no "remember me" opt-in, consistent with the
        // opt-in persistence model (Login.razor).
        await SignInManager.SignInAsync(result.User, isPersistent: false);
        Nav.NavigateTo("/");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter the setup token from the server.")]
        public string SetupToken { get; set; } = "";

        [StringLength(200)]
        public string DisplayName { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, DataType(DataType.Password), MinLength(12, ErrorMessage = "Must be at least 12 characters.")]
        public string Password { get; set; } = "";

        [Required, DataType(DataType.Password), Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
