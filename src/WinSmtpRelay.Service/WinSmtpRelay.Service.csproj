<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinSmtpRelay.Service</RootNamespace>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <!-- Overrides the vulnerable transitive 2.0.0 (NU1903 / GHSA-v5pm-xwqc-g5wc, stack-overflow DoS
         on circular schema references; patched in 2.7.5+). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
    <PackageReference Include="System.Drawing.Common" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinSmtpRelay.Core\WinSmtpRelay.Core.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.SmtpListener\WinSmtpRelay.SmtpListener.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.Delivery\WinSmtpRelay.Delivery.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.Security\WinSmtpRelay.Security.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.Storage\WinSmtpRelay.Storage.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.AdminApi\WinSmtpRelay.AdminApi.csproj" />
    <ProjectReference Include="..\WinSmtpRelay.AdminUi\WinSmtpRelay.AdminUi.csproj" />
  </ItemGroup>

</Project>
