<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- ProductVersion = major.minor.<build number> (Directory.Build.props MsiProductVersion, decision T1077): every
       release build is a strictly greater Windows Installer version, so a plain MajorUpgrade replaces it. -->
  <Package Name="WinSmtpRelay $(var.VersionLabel)"
           Manufacturer="ARDIMEDIA"
           Version="$(var.ProductVersion)"
           UpgradeCode="2cbb38d8-5035-40db-b30b-0e55f24ec496"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="WinSmtpRelay — Open-Source SMTP Relay for Windows" />

    <!-- No AllowSameVersionUpgrades: the same build is a repair, an older build is refused (T1077). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of WinSmtpRelay is already installed. Please uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Custom dialog: choose whether the admin UI is reachable from the network. Inserted between
         InstallDirDlg and VerifyReadyDlg. Default off (loopback only) — secure by default. -->
    <UI>
      <Dialog Id="NetworkOptionsDlg" Width="370" Height="270" Title="WIN-SMTP-RELAY Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Network access and admin-password recovery" />

        <Control Id="NetworkCheckbox" Type="CheckBox" X="20" Y="60" Width="330" Height="18"
                 Property="NETWORKACCESS" CheckBoxValue="1"
                 Text="Make the admin UI reachable from other computers on the network" />
        <Control Id="Info" Type="Text" X="35" Y="82" Width="315" Height="52" Transparent="yes" NoPrefix="yes"
                 Text="Off (recommended): the admin UI binds to 127.0.0.1, reachable only from this computer. On: it binds to the network (all interfaces, or a custom bind address if one is configured) and the admin-port firewall rule is opened. The connection is always HTTPS." />

        <Control Id="ResetPwCheckbox" Type="CheckBox" X="20" Y="145" Width="330" Height="18"
                 Property="RESETADMINPASSWORD" CheckBoxValue="1"
                 Text="Reset administrator access (only if you have lost admin access)" />
        <Control Id="ResetPwInfo" Type="Text" X="35" Y="167" Width="315" Height="58" Transparent="yes" NoPrefix="yes"
                 Text="On the next service start all administrator accounts are removed; you then define a new administrator through first-run setup in the admin UI. Leave this unchecked for normal installs." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Options dialog flow. Fresh install / Change: InstallDirDlg → NetworkOptionsDlg → VerifyReadyDlg.
           Repair: MaintenanceTypeDlg → [Repair] → NetworkOptionsDlg → VerifyReadyDlg, so the operator can set
           network access + password reset just like a normal install. Back returns to InstallDirDlg on a
           fresh install / Change and to MaintenanceTypeDlg on a Repair. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="NetworkOptionsDlg" Order="10" Condition="WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="NetworkOptionsDlg" Order="10" />
      <!-- Mark that the operator confirmed the options dialog in THIS run. The execute sequence uses this
           to NOT re-derive NETWORKACCESS from the saved registry state: an unchecked checkbox leaves the
           property empty, which is indistinguishable from "the dialog never ran" without this marker. -->
      <Publish Dialog="NetworkOptionsDlg" Control="Next" Property="WSRUIRAN" Value="1" Order="5" />
      <Publish Dialog="NetworkOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="10" />
      <Publish Dialog="NetworkOptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="10" Condition="NOT (WixUI_InstallMode = &quot;Repair&quot;)" />
      <Publish Dialog="NetworkOptionsDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="20" Condition="WixUI_InstallMode = &quot;Repair&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="NetworkOptionsDlg" Order="10" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="NetworkOptionsDlg" Order="20" Condition="WixUI_InstallMode = &quot;Repair&quot;" />
    </UI>

    <!-- Detect whether the service was running before upgrade (read during AppSearch, before service is stopped).
         This value lives in the service's own key; it only decides whether to start the service again. -->
    <Property Id="SERVICEWASRUNNING">
      <RegistrySearch Id="ServiceWasRunningSearch"
                      Root="HKLM"
                      Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay"
                      Name="ServiceRunning"
                      Type="raw" />
    </Property>

    <!-- Exit dialog: post-install info text. The service is started by ServiceControl Start="install" in the elevated
         execute sequence. CheckPorts replaces this text on a fresh install (with the chosen port). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="WIN-SMTP-RELAY is installed and the service is starting. Open the admin UI at https://localhost:8025 (also added to the Start menu). The built-in certificate is self-signed, so your browser will warn once - you can import a trusted certificate later in the admin UI. On the first visit the admin UI asks you to create the first administrator. Configuration and data are kept in %ProgramData%\Ardimedia\WinSmtpRelay." />

    <!-- Deferred CA: auto-start service during upgrade if it was running before -->
    <CustomAction Id="StartServiceOnUpgrade"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe start WinSmtpRelay"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- Defensive cleanup: stop and delete any leftover WinSmtpRelay service before (re)installing it,
         so a previous failed/crashed install doesn't block ServiceInstall with "service could not be
         installed". Runs as SYSTEM, before InstallServices. net stop BLOCKS until the service reaches
         STOPPED (sc.exe stop only requests the stop asynchronously — deleting a still-stopping service
         marks it for deletion, which is the exact failure this CA exists to prevent). (A service already
         'marked for deletion' by an open handle can only be cleared by a reboot — no installer can
         override that.) -->
    <CustomAction Id="CleanupLeftoverService"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c &quot;net stop WinSmtpRelay &amp; sc.exe delete WinSmtpRelay&quot;"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- ============================================================
         Managed custom actions (setup/WinSmtpRelay.Setup.CustomActions).
         ============================================================ -->
    <Binary Id="WinSmtpRelayCA"
            SourceFile="$(var.WinSmtpRelay.Setup.CustomActions.TargetDir)WinSmtpRelay.Setup.CustomActions.CA.dll" />

    <!-- Secure so the port read by ReadExistingConfig in the (un-elevated) UI sequence flows to the
         (elevated) execute sequence for WriteAdminConfig, preserving the port on a repair. -->
    <Property Id="ADMINUIPORT" Value="8025" Secure="yes" />
    <Property Id="ADMINUIURL" Value="https://localhost:8025" />
    <!-- Set when the maintenance UI runs; gates whether WriteAdminConfig re-applies the port/bind config on a Repair
         (a silent repair, where the dialog never ran, then preserves the file). -->
    <Property Id="WSRMAINTUI" Secure="yes" />
    <!-- Options-dialog checkboxes, both UNCHECKED by default. No Value on purpose: an MSI CheckBox shows
         CHECKED whenever its property is non-empty, so a "0" default would display as ticked. Secure="yes" passes
         the value set in the (un-elevated) UI sequence to the (elevated) execute sequence. -->
    <Property Id="NETWORKACCESS" Secure="yes" />
    <Property Id="RESETADMINPASSWORD" Secure="yes" />
    <!-- Set by the options dialog's Next button: the operator confirmed the options in THIS run, so the execute
         sequence must respect the (possibly empty = unchecked) NETWORKACCESS instead of restoring the saved state. -->
    <Property Id="WSRUIRAN" Secure="yes" />

    <!-- Firewall choices (ServiceComponents.wxs): "1" opens, any other non-empty value (e.g. "0") closes, empty means
         "fresh-install default, or the choice recorded by the previous install". -->
    <Property Id="FIREWALLSMTP" Secure="yes" />
    <Property Id="FIREWALLSUBMISSION" Secure="yes" />
    <Property Id="FIREWALLSMTPS" Secure="yes" />
    <Property Id="FIREWALLPUBLIC" Secure="yes" />
    <!-- "any" opens the admin-UI rule to every remote address; default (empty) is the local subnet only. -->
    <Property Id="ADMINUIFIREWALLSCOPE" Secure="yes" />
    <!-- REMOVEDATA=1 on uninstall deletes %ProgramData%\Ardimedia\WinSmtpRelay (database, keys, configuration).
         Default: the data is kept. -->
    <Property Id="REMOVEDATA" Secure="yes" />

    <!-- ============================================================
         Upgrade survival. The previous install's admin port, network choice and firewall choices are restored from
         the INSTALLER key (HKLM\SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup), which the service account cannot write — never
         from the service's own key (review finding H14). A value given on the command line always wins (the
         SetPropertys only fill empty properties; the options dialog marks its own values with WSRUIRAN).
         ============================================================ -->
    <Property Id="WSR_SAVEDPORT" Secure="yes">
      <RegistrySearch Id="SavedAdminPortSearch" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="AdminUiPort" Type="raw" />
    </Property>
    <Property Id="WSR_SAVEDNET" Secure="yes">
      <RegistrySearch Id="SavedNetworkAccessSearch" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="AdminUiFirewall" Type="raw" />
    </Property>
    <Property Id="WSR_SAVEDNETANY" Secure="yes">
      <RegistrySearch Id="SavedNetworkAnySearch" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="AdminUiFirewallAny" Type="raw" />
    </Property>
    <Property Id="WSR_FWSTATE" Secure="yes">
      <RegistrySearch Id="SavedFirewallStateSearch" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="FirewallState" Type="raw" />
    </Property>
    <Property Id="WSR_FW25" Secure="yes">
      <RegistrySearch Id="SavedFw25Search" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="FirewallSmtp" Type="raw" />
    </Property>
    <Property Id="WSR_FW587" Secure="yes">
      <RegistrySearch Id="SavedFw587Search" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="FirewallSubmission" Type="raw" />
    </Property>
    <Property Id="WSR_FW465" Secure="yes">
      <RegistrySearch Id="SavedFw465Search" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="FirewallSmtps" Type="raw" />
    </Property>
    <Property Id="WSR_FWPUBLIC" Secure="yes">
      <RegistrySearch Id="SavedFwPublicSearch" Root="HKLM" Key="SOFTWARE\ARDIMEDIA\WinSmtpRelay.Setup" Name="FirewallPublic" Type="raw" />
    </Property>

    <SetProperty Id="ADMINUIPORT" After="AppSearch" Sequence="both" Value="[WSR_SAVEDPORT]"
                 Condition="WSR_SAVEDPORT AND NOT WSRUIRAN" />
    <SetProperty Id="ADMINUIURL" After="AppSearch" Sequence="both" Value="https://localhost:[WSR_SAVEDPORT]"
                 Condition="WSR_SAVEDPORT AND NOT WSRUIRAN" />
    <SetProperty Id="NETWORKACCESS" After="AppSearch" Sequence="both" Value="1"
                 Condition="((WSR_SAVEDNET = &quot;#1&quot;) OR (WSR_SAVEDNETANY = &quot;#1&quot;)) AND NOT WSRUIRAN" />
    <SetProperty Id="ADMINUIFIREWALLSCOPE" After="AppSearch" Sequence="both" Value="any"
                 Condition="(WSR_SAVEDNETANY = &quot;#1&quot;) AND NOT ADMINUIFIREWALLSCOPE" />

    <!-- Port 25: on for a fresh install (and for the first upgrade from a version without recorded choices); after
         that the recorded choice. -->
    <SetProperty Id="FIREWALLSMTP" After="AppSearch" Sequence="both" Value="1"
                 Condition="NOT FIREWALLSMTP AND ((NOT WSR_FWSTATE) OR (WSR_FW25 = &quot;#1&quot;))" />
    <!-- 587 / 465 / Public: off for a fresh install. The first upgrade from a version WITHOUT recorded choices (it
         opened all three ports on every profile) keeps them open, so mail flow on an existing host does not break;
         pass FIREWALLSUBMISSION=0 FIREWALLSMTPS=0 FIREWALLPUBLIC=0 to close them. After that the recorded choice. -->
    <SetProperty Id="FIREWALLSUBMISSION" After="AppSearch" Sequence="both" Value="1"
                 Condition="NOT FIREWALLSUBMISSION AND ((WSR_FWSTATE AND WSR_FW587 = &quot;#1&quot;) OR (NOT WSR_FWSTATE AND WIX_UPGRADE_DETECTED))" />
    <SetProperty Id="FIREWALLSMTPS" After="AppSearch" Sequence="both" Value="1"
                 Condition="NOT FIREWALLSMTPS AND ((WSR_FWSTATE AND WSR_FW465 = &quot;#1&quot;) OR (NOT WSR_FWSTATE AND WIX_UPGRADE_DETECTED))" />
    <SetProperty Id="FIREWALLPUBLIC" After="AppSearch" Sequence="both" Value="1"
                 Condition="NOT FIREWALLPUBLIC AND ((WSR_FWSTATE AND WSR_FWPUBLIC = &quot;#1&quot;) OR (NOT WSR_FWSTATE AND WIX_UPGRADE_DETECTED))" />

    <!-- Maintenance marker: the interactive maintenance UI ran, so WriteAdminConfig may re-apply the
         port/bind config on Repair/Change. -->
    <SetProperty Id="WSRMAINTUI" After="AppSearch" Sequence="ui" Value="1"
                 Condition="Installed AND NOT WIX_UPGRADE_DETECTED" />

    <!-- Immediate: pick a free admin port (8025, 8125, ...), detect port 25, and set
         ADMINUIPORT / ADMINUIURL / PORT25INUSE plus the dynamic exit-dialog text. Optional convenience. -->
    <CustomAction Id="CheckPorts" BinaryRef="WinSmtpRelayCA" DllEntry="CheckPorts"
                  Execute="immediate" Return="ignore" />

    <!-- Immediate: read the existing appsettings.Production.json (data folder, then the legacy program folder) when the
         installer key records no network choice for the admin UI — the first upgrade from a version that kept it in
         the service's key, a pre-build45 install, or a build80 install that lost it that way. Sequenced before
         CostInitialize so NETWORKACCESS also reaches the firewall component's condition. Optional; invalid values are
         ignored. -->
    <CustomAction Id="ReadExistingConfig" BinaryRef="WinSmtpRelayCA" DllEntry="ReadExistingConfig"
                  Execute="immediate" Return="ignore" />

    <!-- Immediate: ADMINUIPORT must be 1-65535, digits only — whatever its source. Stops the installation otherwise. -->
    <CustomAction Id="ValidateAdminPort" BinaryRef="WinSmtpRelayCA" DllEntry="ValidateAdminPort"
                  Execute="immediate" Return="check" />

    <!-- Deferred: move the data of an install that kept it in the program folder into the data folder, exactly once,
         BEFORE InstallFiles (so the operator's appsettings.json is in place before the packaged default would be
         laid down). A failure fails the installation; the rollback action moves everything back; the commit action
         drops the move journal. See LegacyDataMigrator. -->
    <SetProperty Id="MigrateLegacyData" Value="LEGACY=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="MigrateLegacyData" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <SetProperty Id="MigrateLegacyDataRollback" Value="LEGACY=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="MigrateLegacyDataRollback" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <SetProperty Id="MigrateLegacyDataCommit" Value="LEGACY=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="MigrateLegacyDataCommit" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <CustomAction Id="MigrateLegacyDataRollback" BinaryRef="WinSmtpRelayCA" DllEntry="MigrateLegacyDataRollback"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="MigrateLegacyData" BinaryRef="WinSmtpRelayCA" DllEntry="MigrateLegacyData"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="MigrateLegacyDataCommit" BinaryRef="WinSmtpRelayCA" DllEntry="MigrateLegacyDataCommit"
                  Execute="commit" Impersonate="no" Return="ignore" />

    <!-- Deferred: patch appsettings.Production.json (admin Port + BindAddress) in the DATA folder. Runs on a fresh
         install, on a major upgrade, and on a maintenance run that went through the options dialog — not during
         uninstall. The CA merges into the existing file (only the AdminUi keys), so operator overrides survive.
         It refuses an invalid port or tampered CustomActionData. -->
    <SetProperty Id="WriteAdminConfig"
                 Value="DIR=[WsrDataFolder]|PORT=[ADMINUIPORT]|NET=[NETWORKACCESS]"
                 Before="WriteAdminConfig" Sequence="execute"
                 Condition="(NOT Installed) OR (WSRMAINTUI = &quot;1&quot; AND NOT REMOVE)" />
    <CustomAction Id="WriteAdminConfig" BinaryRef="WinSmtpRelayCA" DllEntry="WriteAdminConfig"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- Deferred: explicit ACLs with inheritance broken — program folder (NetworkService read & execute), data folder
         (NetworkService modify), updates\ (NetworkService modify), updater-work\ (SYSTEM + Administrators only).
         A failure FAILS the installation. (MigrateLegacyData already locks the data folders before it moves files.) -->
    <SetProperty Id="HardenFolders" Value="PROGRAM=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="HardenFolders" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <SetProperty Id="HardenFoldersRollback" Value="PROGRAM=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="HardenFoldersRollback" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <SetProperty Id="HardenFoldersCommit" Value="PROGRAM=[INSTALLFOLDER]|DATA=[WsrDataFolder]"
                 Before="HardenFoldersCommit" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <!-- Rollback: give the program folder its previous ACL back (a restored older version still writes its database
         there). Commit: drop the saved ACL. -->
    <CustomAction Id="HardenFoldersRollback" BinaryRef="WinSmtpRelayCA" DllEntry="HardenFoldersRollback"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="HardenFolders" BinaryRef="WinSmtpRelayCA" DllEntry="HardenFolders"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="HardenFoldersCommit" BinaryRef="WinSmtpRelayCA" DllEntry="HardenFoldersCommit"
                  Execute="commit" Impersonate="no" Return="ignore" />

    <!-- Lost-access recovery: when the operator ticks the reset option, set a registry flag the service
         reads on its next start to remove all administrator accounts (the operator then defines a new
         administrator via first-run setup). /reg:64 targets the 64-bit view the service reads. The service
         clears the flag after acting. -->
    <CustomAction Id="SetResetAdminFlag"
                  Directory="System64Folder"
                  ExeCommand="reg.exe add HKLM\SOFTWARE\ARDIMEDIA\WinSmtpRelay /v ResetAdminPassword /t REG_DWORD /d 1 /f /reg:64"
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Register the SYSTEM updater scheduled task (deferred, as SYSTEM). The task definition and its script are
         embedded in the custom-action assembly — nothing is read from a folder the service account can write
         (decision T1076). A failure fails the installation: without the task the self-update silently never works. -->
    <SetProperty Id="RegisterUpdateTask" Value="WORK=[UpdaterWorkFolder]"
                 Before="RegisterUpdateTask" Sequence="execute" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <CustomAction Id="RegisterUpdateTask" BinaryRef="WinSmtpRelayCA" DllEntry="RegisterUpdateTask"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- Remove the updater task on a real uninstall (not when a newer version replaces this one: it re-registers). -->
    <CustomAction Id="UnregisterUpdateTask" BinaryRef="WinSmtpRelayCA" DllEntry="UnregisterUpdateTask"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- REMOVEDATA=1: delete the data folder on a real uninstall. -->
    <SetProperty Id="RemoveData" Value="DATA=[WsrDataFolder]"
                 Before="RemoveData" Sequence="execute"
                 Condition="REMOVE = &quot;ALL&quot; AND REMOVEDATA = &quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RemoveData" BinaryRef="WinSmtpRelayCA" DllEntry="RemoveData"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- ReadExistingConfig runs before CostInitialize so its NETWORKACCESS reaches the component conditions (the
         admin-UI firewall rule); it runs whenever no network choice is recorded in the installer key. -->
    <InstallUISequence>
      <Custom Action="ReadExistingConfig" Before="CostInitialize"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT (WSR_SAVEDNET = &quot;#1&quot; OR WSR_SAVEDNETANY = &quot;#1&quot;)" />
      <Custom Action="CheckPorts" After="CostFinalize"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ValidateAdminPort" After="CheckPorts"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <!-- NOT WSRUIRAN: when the options dialog ran, its (Secure) values must win. -->
      <Custom Action="ReadExistingConfig" Before="CostInitialize"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT (WSR_SAVEDNET = &quot;#1&quot; OR WSR_SAVEDNETANY = &quot;#1&quot;) AND (NOT WSRUIRAN)" />
      <Custom Action="CheckPorts" After="CostFinalize"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ValidateAdminPort" After="CheckPorts"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="CleanupLeftoverService" Before="InstallServices"
              Condition="NOT Installed" />
      <Custom Action="MigrateLegacyDataRollback" Before="MigrateLegacyData"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="MigrateLegacyData" Before="InstallFiles"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="MigrateLegacyDataCommit" After="MigrateLegacyData"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="WriteAdminConfig" After="InstallFiles"
              Condition="(NOT Installed) OR (WSRMAINTUI = &quot;1&quot; AND NOT REMOVE)" />
      <Custom Action="HardenFoldersRollback" After="WriteAdminConfig"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="HardenFolders" After="HardenFoldersRollback"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="HardenFoldersCommit" After="HardenFolders"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="RegisterUpdateTask" After="HardenFoldersCommit"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="SetResetAdminFlag" After="WriteRegistryValues"
              Condition="RESETADMINPASSWORD = &quot;1&quot;" />
      <Custom Action="StartServiceOnUpgrade"
              After="StartServices"
              Condition="WIX_UPGRADE_DETECTED AND (SERVICEWASRUNNING = &quot;#1&quot;)" />
      <Custom Action="UnregisterUpdateTask" Before="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveData" After="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND REMOVEDATA = &quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- .NET 10 runtime check for framework-dependent variant -->
    <?if $(var.SelfContained) = false ?>
    <Property Id="NETCORERUNTIME10">
      <RegistrySearch Id="NetCore10Search"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Type="raw" />
    </Property>
    <Launch Condition="Installed OR NETCORERUNTIME10"
            Message="WinSmtpRelay requires the .NET 10 Runtime (x64). Please download and install it from https://dotnet.microsoft.com/download/dotnet/10.0 and run this installer again." />
    <?endif?>

    <!-- Program folder (binaries only). The data folder is defined in ServiceComponents.wxs. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinSmtpRelay" />
    </StandardDirectory>
    <!-- Start menu (All Users) — holds the admin-UI shortcut -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Single feature containing all components -->
    <Feature Id="Complete" Title="WinSmtpRelay" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="DataFolderComponent" />
      <ComponentRef Id="ConfigComponent" />
      <ComponentRef Id="InstallerState" />
      <ComponentRef Id="ServiceStateRegistry" />
      <ComponentRef Id="FirewallSmtp" />
      <ComponentRef Id="FirewallSmtpPublic" />
      <ComponentRef Id="FirewallSubmission" />
      <ComponentRef Id="FirewallSubmissionPublic" />
      <ComponentRef Id="FirewallSmtps" />
      <ComponentRef Id="FirewallSmtpsPublic" />
      <ComponentRef Id="FirewallPublicState" />
      <ComponentRef Id="AdminUiFirewall" />
      <ComponentRef Id="AdminUiFirewallAny" />
      <ComponentRef Id="EventLogSource" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UpdateDropFolderComponent" />
      <ComponentRef Id="UpdaterWorkFolderComponent" />

      <!-- Auto-harvested published files. appsettings.json goes to the data folder (ConfigComponent);
           appsettings.Development.json is never shipped. -->
      <Files Directory="INSTALLFOLDER" Include="$(var.HarvestPath)**">
        <Exclude Files="$(var.HarvestPath)appsettings.json" />
        <Exclude Files="$(var.HarvestPath)appsettings.Development.json" />
        <Exclude Files="$(var.HarvestPath)WinSmtpRelay.Service.exe" />
      </Files>
    </Feature>

  </Package>

</Wix>
